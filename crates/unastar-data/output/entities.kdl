            add minecraft:cow_adult
            remove minecraft:cow_baby
        }
        event entity_born {
            add minecraft:cow_baby
        }
        event entity_spawned
        event entity_transformed {
            add minecraft:cow_adult
        }
        event spawn_adult {
            add minecraft:cow_adult
        }
    }
}
entity minecraft:creaking {
    spawn_category monster
    is_spawnable #true
    is_summonable #true
    properties {
        creaking_state type=enum client_sync=#true {
            value neutral
            value hostile_observed
            value hostile_unobserved
            value twitching
            value crumbling
            default neutral
        }
        creaking_swaying_ticks type=int min=0 max=6 default="0" client_sync=#true
    }
    components {
        attack damage=3
        can_climb
        collision_box height=2.7 width=0.9
        despawn {
            despawn_from_distance
        }
        follow_range 32 max=32
        health 1 max=1
        is_hidden_when_invisible
        jump.static
        movement.basic
        nameable
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        renders_when_invisible
        type_family {
            family creaking
            family monster
            family mob
        }
        variable_max_auto_step base_value=1.0625 jump_prevented_value=0.5625
    }
    component_groups {
        group crumbling {
            instant_despawn
        }
        group hostile {
            ambient_sound_interval event_name=undefined
            looked_at {
                field_of_view 120
                filters {
                    none_of {
                        filter test=actor_health subject=target value=0
                        filter test=has_equipment subject=other domain=head value=carved_pumpkin
                    }
                }
                find_players_only #true
                line_of_sight_obstruction_type collision_for_camera
                look_at_location location=head
                look_at_location location=body
                look_at_location location=feet vertical_offset=0.5
                looked_at_cooldown 0.1
                looked_at_event {
                    event minecraft:on_target_start_looking
                    filter self
                }
                not_looked_at_event {
                    event minecraft:on_target_stop_looking
                    filter self
                }
                scale_fov_by_distance #false
                search_radius 24.0
                set_target never
            }
        }
        group hostile_unobserved {
            behavior.melee_box_attack cooldown_time=2.0 priority=2
        }
        group immobile {
            body_rotation_blocked
            knockback_resistance 1.0
            movement 0.0
            pushable is_pushable=#false is_pushable_by_piston=#false
        }
        group mobile {
            behavior.float priority=0
            knockback_resistance 0.0
            movement 0.4
            pushable is_pushable=#true is_pushable_by_piston=#true
        }
        group neutral {
            ambient_sound_interval
            behavior.random_stroll priority=7 speed_multiplier=0.3
            looked_at {
                field_of_view 120
                filters test=actor_health subject=other operator=> value=0
                find_players_only #true
                line_of_sight_obstruction_type collision_for_camera
                look_at_location location=head
                look_at_location location=body
                look_at_location location=feet vertical_offset=0.5
                looked_at_cooldown 0.1
                looked_at_event {
                    event minecraft:become_hostile
                    filter self
                }
                scale_fov_by_distance #false
                search_radius 12.0
                set_target once_and_keep_scanning
            }
        }
        group spawned_by_creaking_heart {
            damage_sensor {
                trigger cause=void deals_damage=yes
                trigger {
                    cause all
                    deals_damage no_but_side_effects_apply
                    on_damage {
                        event minecraft:damaged_by_player
                        filters test=is_family subject=other value=player
                    }
                }
                trigger {
                    cause all
                    deals_damage no_but_side_effects_apply
                    on_damage {
                        event minecraft:damaged_by_entity
                        filters test=is_family subject=other value=mob
                    }
                }
                trigger {
                    cause projectile
                    deals_damage no_but_side_effects_apply
                    on_damage {
                        event minecraft:damaged_by_entity
                    }
                }
                trigger cause=all deals_damage=no_but_side_effects_apply
            }
            dimension_bound
            environment_sensor {
                trigger {
                    event minecraft:become_neutral
                    filters {
                        filter {
                            any_of {
                                filter test=enum_property domain=minecraft:creaking_state value=hostile_observed
                                filter test=enum_property domain=minecraft:creaking_state value=hostile_unobserved
                            }
                        }
                        filter {
                            any_of {
                                filter test=has_target value=#false
                                filter test=actor_health subject=target value=0
                                filter test=target_distance operator=> value=24
                            }
                        }
                    }
                }
                trigger {
                    event minecraft:crumble_and_notify_creaking_heart
                    filters {
                        filter {
                            none_of {
                                filter test=enum_property domain=minecraft:creaking_state value=twitching
                                filter test=has_nametag
                            }
                        }
                        filter {
                            any_of {
                                filter test=home_distance operator=> value=34
                                filter test=hourly_clock_time operator=> value=23400
                                filter test=hourly_clock_time operator="<=" value=12600
                            }
                        }
                    }
                }
                trigger {
                    event minecraft:crumble
                    filters {
                        filter test=enum_property operator=not domain=minecraft:creaking_state value=twitching
                        filter test=enum_property operator=not domain=minecraft:creaking_state value=crumbling
                        filter test=is_bound_to_creaking_heart value=#false
                    }
                }
                trigger {
                    event minecraft:increment_swaying_ticks
                    filters {
                        filter test=int_property operator=> domain=minecraft:creaking_swaying_ticks value=0
                        filter test=int_property operator="<=" domain=minecraft:creaking_swaying_ticks value=5
                    }
                }
                trigger {
                    event minecraft:reset_swaying_ticks
                    filters test=int_property operator=> domain=minecraft:creaking_swaying_ticks value=5
                }
            }
            fire_immune
            home restriction_radius=32 restriction_type=all_movement
            navigation.walk avoid_damage_blocks=#false can_path_over_lava=#true can_path_over_water=#true
        }
        group spawned_by_player {
            environment_sensor {
                trigger {
                    event minecraft:become_neutral
                    filters {
                        filter {
                            any_of {
                                filter test=enum_property domain=minecraft:creaking_state value=hostile_observed
                                filter test=enum_property domain=minecraft:creaking_state value=hostile_unobserved
                            }
                        }
                        filter {
                            any_of {
                                filter test=has_target value=#false
                                filter test=actor_health subject=target value=0
                                filter test=target_distance operator=> value=24
                            }
                        }
                    }
                }
            }
            hurt_on_condition {
                condition {
                    cause lava
                    damage_per_tick 4
                    filters test=in_lava
                }
            }
            navigation.walk avoid_damage_blocks=#true can_path_over_lava=#false can_path_over_water=#true
        }
        group twitching {
            behavior.timer_flag_1 {
                cooldown_range 0.0
                entry 2.25
                entry 2.25
                on_end {
                    event minecraft:crumble
                    target self
                }
                priority 0
            }
        }
    }
    events {
        event become_hostile {
            add minecraft:hostile
            add minecraft:immobile
            remove minecraft:neutral
            remove minecraft:hostile_unobserved
            remove minecraft:mobile
        }
        event become_neutral {
            add minecraft:neutral
            add minecraft:mobile
            remove minecraft:hostile
            remove minecraft:hostile_unobserved
            remove minecraft:immobile
        }
        event crumble {
            add minecraft:immobile
            add minecraft:crumbling
            remove minecraft:neutral
            remove minecraft:hostile
            remove minecraft:hostile_unobserved
            remove minecraft:twitching
            remove minecraft:mobile
        }
        event crumble_and_notify_creaking_heart {
            trigger minecraft:crumble
        }
        event damaged_by_entity {
            trigger minecraft:increment_swaying_ticks
        }
        event damaged_by_player {
            trigger minecraft:increment_swaying_ticks
        }
        event entity_spawned {
            add minecraft:spawned_by_player
            add minecraft:neutral
            add minecraft:mobile
        }
        event entity_spawned_by_creaking_heart {
            add minecraft:spawned_by_creaking_heart
            add minecraft:neutral
            add minecraft:mobile
        }
        event increment_swaying_ticks
        event on_target_start_looking {
            add minecraft:hostile
            add minecraft:immobile
            remove minecraft:neutral
            remove minecraft:hostile_unobserved
            remove minecraft:mobile
        }
        event on_target_stop_looking {
            add minecraft:hostile
            add minecraft:hostile_unobserved
            add minecraft:mobile
            remove minecraft:neutral
            remove minecraft:immobile
        }
        event reset_swaying_ticks
        event start_twitching {
            add minecraft:immobile
            add minecraft:twitching
            remove minecraft:neutral
            remove minecraft:hostile
            remove minecraft:hostile_unobserved
            remove minecraft:mobile
        }
    }
}
entity minecraft:creeper {
