    }
    component_groups {
        group above_bubble_column_down {
            buoyant {
                apply_gravity #true
                base_buoyancy 1.0
                drag_down_on_buoyancy_removed 0.7
                liquid_block minecraft:water
                liquid_block minecraft:flowing_water
                simulate_waves #false
            }
            out_of_control
            timer {
                looping #false
                time 3
                time_down_event {
                    event minecraft:sink
                    target self
                }
            }
        }
        group above_bubble_column_up {
            buoyant {
                apply_gravity #true
                base_buoyancy 1.0
                drag_down_on_buoyancy_removed 0.7
                liquid_block minecraft:water
                liquid_block minecraft:flowing_water
                simulate_waves #false
            }
            out_of_control
        }
        group can_ride_bamboo {
            rideable {
                interact_text action.interact.ride.boat
                passenger_max_width 1.375
                pull_in_entities #true
                seat_count 1
                seat {
                    lock_rider_rotation 90
                    max_rider_count 1
                    min_rider_count 0
                    entry 0.2
                    entry 0.1
                    entry 0.0
                    rotate_rider_by "query.has_any_family('blaze', 'creeper', 'enderman', 'illager', 'magmacube', 'piglin', 'player', 'skeleton', 'slime', 'villager', 'wandering_trader', 'witch', 'zombie', 'zombie_pigman', 'happy_ghast', 'copper_golem') ? -90 : 0"
                }
            }
        }
        group can_ride_default {
            rideable {
                interact_text action.interact.ride.boat
                passenger_max_width 1.375
                pull_in_entities #true
                seat_count 1
                seat {
                    lock_rider_rotation 90
                    max_rider_count 1
                    min_rider_count 0
                    entry 0.2
                    entry -0.2
                    entry 0.0
                    rotate_rider_by "query.has_any_family('blaze', 'creeper', 'enderman', 'illager', 'magmacube', 'piglin', 'player', 'skeleton', 'slime', 'villager', 'wandering_trader', 'witch', 'zombie', 'zombie_pigman', 'happy_ghast', 'copper_golem') ? -90 : 0"
                }
            }
        }
        group floating {
            buoyant {
                apply_gravity #true
                base_buoyancy 1.0
                big_wave_probability 0.03
                big_wave_speed 10.0
                liquid_block minecraft:water
                liquid_block minecraft:flowing_water
                simulate_waves #true
            }
        }
    }
    events {
        event add_can_ride
        event entered_bubble_column_down {
            add minecraft:above_bubble_column_down
            remove minecraft:floating
        }
        event entered_bubble_column_up {
            add minecraft:above_bubble_column_up
            remove minecraft:floating
        }
        event entity_spawned {
            trigger minecraft:add_can_ride
        }
        event exited_bubble_column {
            add minecraft:floating
            remove minecraft:above_bubble_column_down
            remove minecraft:above_bubble_column_up
            trigger minecraft:add_can_ride
        }
        event sink {
            remove minecraft:floating
            remove minecraft:can_ride_default
            remove minecraft:can_ride_bamboo
            remove minecraft:above_bubble_column_down
            remove minecraft:above_bubble_column_up
        }
    }
}
