            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/pig.json"
        }
        group pig_baby {
            ageable {
                duration 1200
                feed_item carrot
                feed_item beetroot
                feed_item potato
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=6 speed_multiplier=1.1
            is_baby
            scale 0.5
        }
        group pig_saddled {
            behavior.controlled_by_player priority=0
            boostable {
                boost_item damage=2 item=carrotOnAStick replace_item=fishing_rod
                duration 3.0
                speed_multiplier 1.35
            }
            interact {
                interaction {
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        event minecraft:on_unsaddled
                        filters {
                            filter test=is_sneak_held subject=other value=#false
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=rider_count subject=self operator=equals value=0
                        }
                    }
                    play_sounds unsaddle
                    spawn_items {
                        table "loot_tables/entities/saddle.json"
                    }
                    vibration shear
                }
            }
            is_saddled
            item_controllable control_items=carrotOnAStick
            loot table="loot_tables/entities/pig_saddled.json"
            rideable {
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.63
                    seat 0.0
                }
            }
        }
        group pig_transform {
            transformation delay=0.5 into=minecraft:pig_zombie transformation_sound=mob.pig.death
        }
        group pig_unsaddled {
            interact {
                interaction {
                    interact_text action.interact.saddle
                    on_interact {
                        event minecraft:on_saddled
                        filters test=has_equipment subject=other domain=hand value=saddle
                    }
                    play_sounds saddle
                    use_item #true
                }
            }
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.7
                    seat 0.0
                }
            }
        }
    }
    events {
        event become_zombie {
            add minecraft:pig_transform
        }
        event ageable_grow_up {
            add minecraft:pig_adult
            add minecraft:pig_unsaddled
            remove minecraft:pig_baby
        }
        event entity_born {
            add minecraft:pig_baby
        }
        event entity_spawned
        event on_saddled {
            add minecraft:pig_saddled
            remove minecraft:pig_unsaddled
        }
        event on_unsaddled {
            add minecraft:pig_unsaddled
            remove minecraft:pig_saddled
        }
        event spawn_adult {
            add minecraft:pig_adult
            add minecraft:pig_unsaddled
        }
    }
}
