                drop_item turtle_shell_piece
                duration 1200
                feed_item seagrass
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.move_to_water goal_radius=0.1 priority=1 search_height=5 search_range=15
            collision_box height=0.2 width=0.6
            is_baby
            scale 0.16
            type_family {
                family aquatic
                family turtle
                family baby_turtle
                family mob
            }
            underwater_movement 0.06
        }
        group pregnant {
            behavior.go_home {
                goal_radius 4.0
                interval 700
                entry event=minecraft:go_lay_egg target=self
                priority 1
                speed_multiplier 1.0
            }
        }
        group wants_to_lay_egg {
            behavior.lay_egg {
                goal_radius 1.5
                on_lay {
                    event minecraft:laid_egg
                    target self
                }
                priority 1
                search_height 4
                search_range 16
                speed_multiplier 1.0
            }
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:adult
            remove minecraft:baby
        }
        event become_pregnant {
            add minecraft:pregnant
        }
        event entity_born {
            add minecraft:baby
        }
        event entity_spawned {
            randomize {
                option weight=9
                option weight=1
            }
        }
        event go_lay_egg {
            add minecraft:wants_to_lay_egg
            remove minecraft:pregnant
        }
        event laid_egg {
            remove minecraft:wants_to_lay_egg
        }
    }
}
