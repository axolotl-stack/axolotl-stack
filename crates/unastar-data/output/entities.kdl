            }
            condition {
                cause temperature
                damage_per_tick 1
                filters {
                    filter test=is_temperature_value operator=> value=1.0
                    filter test=has_component subject=self operator="!=" value=minecraft:effect.fire_resistance
                }
            }
            condition {
                cause drowning
                damage_per_tick 1
                filters test=in_contact_with_water operator="==" value=#true
            }
        }
        interact {
            interaction {
                cooldown 2.5
                hurt_item 1
                interact_text action.interact.shear
                on_interact {
                    event minecraft:on_sheared
                    filters {
                        filter test=has_equipment subject=other domain=hand value=shears
                        filter test=is_family subject=other value=player
                        filter test=has_component operator="!=" value=minecraft:is_sheared
                    }
                    target self
                }
                play_sounds shear
                spawn_items {
                    table "loot_tables/entities/snow_golem_shear.json"
                }
                use_item #false
                vibration shear
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable
        leashable_to
        loot table="loot_tables/entities/snowman.json"
        movement 0.2
        movement.basic
        nameable
        navigation.walk avoid_water=#true
        persistent
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        shooter def=minecraft:snowball
        trail {
            block_type minecraft:snow_layer
            spawn_filter {
                operator <
                test is_temperature_value
                value 0.81
            }
        }
        type_family {
            family snowgolem
            family mob
        }
    }
    component_groups {
        group snowman_sheared {
            is_sheared
        }
    }
    events {
        event on_sheared {
            add minecraft:snowman_sheared
        }
    }
}
