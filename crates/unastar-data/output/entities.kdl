            behavior.dragonchargeplayer priority=1
            behavior.dragonholdingpattern priority=3
            behavior.dragonstrafeplayer priority=2
            behavior.dragontakeoff priority=0
            shooter def=minecraft:dragon_fireball
        }
        group dragon_sitting {
            behavior.dragonflaming priority=1
            behavior.dragonlanding priority=0
            behavior.dragonscanning priority=2
        }
    }
    events {
        event entity_spawned {
            add dragon_flying
        }
        event start_death {
            add dragon_death
            remove dragon_sitting
            remove dragon_flying
        }
        event start_fly {
            add dragon_flying
            remove dragon_sitting
        }
        event start_land {
            add dragon_sitting
            remove dragon_flying
        }
    }
}
