                entry {
                    entry minecraft:gold_block
                    entry minecraft:gilded_blackstone
                    entry minecraft:nether_gold_ore
                    entry minecraft:deepslate_gold_ore
                    entry minecraft:raw_gold_block
                    entry minecraft:gold_ore
                    entry minecraft:chest
                    entry minecraft:trapped_chest
                    entry minecraft:ender_chest
                    entry minecraft:copper_chest
                    entry minecraft:exposed_copper_chest
                    entry minecraft:weathered_copper_chest
                    entry minecraft:oxidized_copper_chest
                    entry minecraft:waxed_copper_chest
                    entry minecraft:waxed_exposed_copper_chest
                    entry minecraft:waxed_weathered_copper_chest
                    entry minecraft:waxed_oxidized_copper_chest
                    entry minecraft:barrel
                    entry minecraft:white_shulker_box
                    entry minecraft:orange_shulker_box
                    entry minecraft:magenta_shulker_box
                    entry minecraft:light_blue_shulker_box
                    entry minecraft:yellow_shulker_box
                    entry minecraft:lime_shulker_box
                    entry minecraft:pink_shulker_box
                    entry minecraft:gray_shulker_box
                    entry minecraft:light_gray_shulker_box
                    entry minecraft:cyan_shulker_box
                    entry minecraft:purple_shulker_box
                    entry minecraft:blue_shulker_box
                    entry minecraft:brown_shulker_box
                    entry minecraft:green_shulker_box
                    entry minecraft:red_shulker_box
                    entry minecraft:black_shulker_box
                    entry minecraft:undyed_shulker_box
                    on_block_broken important_block_destroyed_event
                }
                sensor_radius 16
            }
            celebrate_hunt {
                broadcast #true
                celebrate_sound celebrate
                celebration_targets {
                    filter test=is_family value=hoglin
                }
                duration 10
                radius 16
                sound_interval {
                    range_max 5.0
                    range_min 2.0
                }
            }
            experience_reward on_death="query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            group_size {
                filters {
                    filter test=has_component operator=not value=minecraft:is_baby
                    filter test=is_family value=piglin
                }
                radius 32
            }
            movement 0.35
        }
        group piglin_baby {
            behavior.panic priority=1 speed_multiplier=1.1
            experience_reward on_death="query.last_hit_by_player ? 1 + (query.equipment_count * Math.Random(1,2)) : 0"
            is_baby
            movement 0.42
            scale 0.5
        }
        group piglin_jockey {
            behavior.find_mount max_failed_attempts=20 priority=1 start_delay=15 within_radius=16
        }
        group ranged_unit {
            behavior.charge_held_item {
                item minecraft:arrow
                priority 3
            }
            behavior.ranged_attack {
                attack_interval_max 1
                attack_interval_min 1
                attack_radius 8
                attack_radius_min 4
                priority 8
                speed_multiplier 1.0
                target_in_sight_time 0.1
            }
            equipment table="loot_tables/entities/piglin_gear_ranged.json"
            shooter def=minecraft:arrow
            variant 0
        }
        group start_zombification {
            environment_sensor {
                triggers {
                    event stop_zombification_event
                    filters test=in_nether
                }
            }
            is_shaking
            timer {
                looping #false
                time 15
                time_down_event {
                    event become_zombie_event
                }
            }
        }
        group take_target_as_response_to_block_break {
            behavior.nearest_attackable_target {
                entity_type {
                    filters test=is_family subject=other value=player
                    max_dist 16
                }
                priority 7
            }
        }
        group zombification_sensor {
            environment_sensor {
                triggers {
                    event start_zombification_event
                    filters test=in_nether value=#false
                }
            }
        }
    }
    events {
        event admire_item_started_event {
            remove interactable_piglin
        }
        event admire_item_stopped_event {
            add interactable_piglin
        }
        event attack_cooldown_complete_event {
            remove attack_cooldown
        }
        event become_angry_event {
            add angry
        }
        event become_calm_event {
            add alert_for_attack_targets
            add attack_cooldown
            remove angry
            remove take_target_as_response_to_block_break
        }
        event become_zombie_event {
            add become_zombie
        }
        event important_block_destroyed_event {
            add take_target_as_response_to_block_break
            remove alert_for_attack_targets
        }
        event entity_born {
            trigger spawn_baby
        }
        event entity_spawned {
            randomize {
                option weight=5 trigger=spawn_baby
                option weight=95 trigger=spawn_adult
            }
        }
        event spawn_adult {
            randomize {
                option weight=1 trigger=spawn_adult_ranged
                option weight=1 trigger=spawn_adult_melee
            }
        }
        event spawn_adult_melee {
            add piglin_adult
            add zombification_sensor
            add alert_for_attack_targets
            add melee_unit
            add attack_cooldown
            add hunter
            add interactable_piglin
        }
        event spawn_adult_melee_no_hunting {
            add piglin_adult
            add zombification_sensor
            add alert_for_attack_targets
            add melee_unit
            add attack_cooldown
            add not_hunter
            add interactable_piglin
        }
        event spawn_adult_no_hunting {
            randomize {
                option weight=1 trigger=spawn_adult_ranged_no_hunting
                option weight=1 trigger=spawn_adult_melee_no_hunting
            }
        }
        event spawn_adult_ranged {
            add piglin_adult
            add zombification_sensor
            add alert_for_attack_targets
            add ranged_unit
            add attack_cooldown
            add hunter
            add interactable_piglin
        }
        event spawn_adult_ranged_no_hunting {
            add piglin_adult
            add zombification_sensor
            add alert_for_attack_targets
            add ranged_unit
            add attack_cooldown
            add not_hunter
            add interactable_piglin
        }
        event spawn_baby {
            randomize {
                option weight=9
                option weight=1
            }
        }
        event start_zombification_event {
            add start_zombification
            remove zombification_sensor
        }
        event stop_zombification_event {
            add zombification_sensor
            remove start_zombification
        }
    }
}
