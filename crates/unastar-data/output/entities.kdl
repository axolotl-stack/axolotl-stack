        group melee_mode {
            attack damage=3
            behavior.melee_box_attack can_spread_on_fire=#true priority=3 require_complete_path=#true speed_multiplier=1 track_target=#false
        }
        group mode_switcher {
            target_nearby_sensor {
                inside_range 3.0
                on_inside_range {
                    event minecraft:switch_to_melee
                    target self
                }
                on_outside_range {
                    event minecraft:switch_to_ranged
                    target self
                }
                outside_range 5.0
            }
        }
        group ranged_equipment {
            equipment {
                entry drop_chance=1.0 slot=slot.weapon.offhand
                table "loot_tables/entities/drowned_ranged_equipment.json"
            }
        }
        group ranged_mode {
            behavior.ranged_attack attack_interval_max=3.0 attack_interval_min=1.0 attack_radius=10.0 priority=3 swing=#true
            shooter def=minecraft:thrown_trident sound=item.trident.throw
        }
        group wander_mode {
            navigation.generic avoid_sun=#true can_break_doors=#true can_path_over_water=#false can_swim=#false can_walk=#true is_amphibious=#true
        }
    }
    events {
        event as_adult {
            add minecraft:melee_equipment
            add minecraft:melee_mode
            add minecraft:adult_drowned
            add minecraft:wander_mode
        }
        event as_baby {
            add minecraft:melee_equipment
            add minecraft:melee_mode
            add minecraft:baby_drowned
            add minecraft:wander_mode
        }
        event as_ranged_adult {
            add minecraft:mode_switcher
            add minecraft:ranged_equipment
            add minecraft:ranged_mode
            add minecraft:adult_drowned
            add minecraft:wander_mode
        }
        event as_rider {
            add minecraft:adult_drowned
            add minecraft:ranged_mode
            add minecraft:drowned_rider
            remove minecraft:melee_equipment
            remove minecraft:ranged_equipment
            remove minecraft:melee_mode
            remove minecraft:baby_drowned
            remove minecraft:wander_mode
            remove minecraft:mode_switcher
        }
        event entity_spawned
        event has_target {
            add minecraft:hunter_mode
            remove minecraft:wander_mode
        }
        event lost_target {
            add minecraft:wander_mode
            remove minecraft:hunter_mode
        }
        event switch_to_melee {
            add minecraft:melee_mode
            remove minecraft:ranged_mode
        }
        event switch_to_ranged {
            add minecraft:ranged_mode
            remove minecraft:melee_mode
        }
    }
}
