                    any_of {
                        filter test=is_family subject=other value=player
                        filter test=is_family subject=other value=snowgolem
                        filter test=is_family subject=other value=irongolem
                    }
                }
                max_dist 16
            }
            must_see #true
            priority 2
        }
        behavior.slime_attack priority=3
        behavior.slime_float jump_chance_percentage=0.8 priority=1 speed_multiplier=1.2
        behavior.slime_keep_on_jumping priority=5 speed_multiplier=1.0
        behavior.slime_random_direction add_random_time_range=3 min_change_direction_time=2.0 priority=4 turn_range=360
        breathable suffocate_time=0 total_supply=15
        can_climb
        collision_box height=2.08 width=2.08
        conditional_bandwidth_optimization
        despawn {
            despawn_from_distance
        }
        experience_reward on_death="query.last_hit_by_player ? query.variant : 0"
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        mob_effect_immunity {
            mob_effect oozing
        }
        movement.jump {
            entry 0.5
            entry 1.5
        }
        nameable
        navigation.walk avoid_water=#true can_path_over_water=#true
        on_target_acquired event=minecraft:become_aggressive target=self
        on_target_escape event=minecraft:become_calm target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family slime
            family monster
            family mob
        }
    }
    component_groups {
        group slime_aggressive {
            movement.jump {
                entry 0.16
                entry 0.5
            }
        }
        group slime_calm {
            movement.jump {
                entry 0.5
                entry 1.5
            }
        }
        group slime_large {
            area_attack {
                cause entity_attack
                damage_cooldown 0.5
                damage_per_tick 4
                damage_range 0.15
                entity_filter {
                    filter subject=other test=is_family value=player
                    filter subject=other test=is_family value=irongolem
                    filter subject=other test=is_family value=snowgolem
                }
            }
            attack damage=4
            collision_box height=2.08 width=2.08
            health 16 max=16
            movement 0.6
            variant 4
        }
        group slime_medium {
            area_attack {
                cause entity_attack
                damage_cooldown 0.5
                damage_per_tick 2
                damage_range 0.15
                entity_filter {
                    filter subject=other test=is_family value=player
                    filter subject=other test=is_family value=irongolem
                    filter subject=other test=is_family value=snowgolem
                }
            }
            attack damage=2
            collision_box height=1.04 width=1.04
            health 4 max=4
            movement 0.4
            variant 2
        }
        group slime_small {
            attack damage=0
            collision_box height=0.52 width=0.52
            health 1 max=1
            loot table="loot_tables/entities/slime.json"
            movement 0.3
            variant 1
        }
    }
    events {
        event become_aggressive {
            add minecraft:slime_aggressive
        }
        event become_calm {
            add minecraft:slime_calm
        }
        event entity_spawned {
            randomize {
                option weight=1 trigger=spawn_small
                option weight=1 trigger=spawn_medium
                option weight=1 trigger=spawn_large
            }
        }
        event spawn_large {
            add minecraft:slime_large
            add minecraft:slime_calm
        }
        event spawn_medium {
            add minecraft:slime_medium
            add minecraft:slime_calm
        }
        event spawn_small {
            add minecraft:slime_small
            add minecraft:slime_calm
        }
    }
}
