            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    lock_rider_rotation 0
                    seat 0.0
                    seat 1.175
                    seat -0.35
                }
            }
        }
        group pig_zombie_angry {
            angry {
                broadcast_anger #true
                broadcast_anger_when_dying #false
                broadcast_range 20
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 25
            }
        }
        group pig_zombie_baby {
            experience_reward on_death="query.last_hit_by_player ? 12 + (query.equipment_count * Math.Random(1,3)) : 0"
            is_baby
            scale 0.5
        }
        group pig_zombie_calm {
            on_target_acquired event=minecraft:become_angry target=self
        }
        group strider_jockey {
            equipment table="loot_tables/entities/zombified_piglin_rider_gear.json"
        }
    }
    events {
        event become_angry {
            add minecraft:pig_zombie_angry
            remove minecraft:pig_zombie_calm
        }
        event entity_spawned {
            randomize {
                option weight=95 trigger=spawn_adult
                option weight=5 trigger=spawn_baby
            }
        }
        event entity_transformed
        event on_calm {
            add minecraft:pig_zombie_calm
            remove minecraft:pig_zombie_angry
        }
        event spawn_as_strider_jockey {
            add minecraft:strider_jockey
        }
        event spawn_adult {
            add minecraft:pig_zombie_adult
            add minecraft:pig_zombie_calm
        }
        event spawn_baby {
            add minecraft:pig_zombie_baby
            add minecraft:pig_zombie_calm
        }
    }
}
