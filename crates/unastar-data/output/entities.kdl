entity minecraft:mule {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    components {
        ambient_sound_interval
        balloonable
        behavior.float chance_per_tick_to_float=1.0 priority=0 time_under_water_to_dismount_passengers=2.0
        behavior.look_at_player look_distance=6.0 priority=7 probability=0.02
        behavior.panic priority=1 speed_multiplier=1.2
        behavior.random_look_around priority=8
        behavior.random_stroll priority=6 speed_multiplier=0.7
        behavior.tempt {
            item golden_apple
            item appleEnchanted
            item golden_carrot
            priority 5
            speed_multiplier 1.2
        }
        breathable suffocate_time=0 total_supply=15
        collision_box height=1.6 width=1.4
        conditional_bandwidth_optimization
        despawn {
            despawn_from_distance
        }
        healable {
            item heal_amount=2 item=wheat
            item heal_amount=1 item=sugar
            item heal_amount=20 item=hay_block
            item heal_amount=3 item=apple
            item heal_amount=3 item=carrot
            item heal_amount=4 item=golden_carrot
            item heal_amount=10 item=golden_apple
            item heal_amount=10 item=appleEnchanted
        }
        health {
            value {
                range_max 30
                range_min 15
            }
        }
        horse.jump_strength 0.5
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable {
            preset {
                filter test=is_family subject=other value=happy_ghast
                spring_type quad_dampened
            }
        }
        movement 0.175
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_path_over_water=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family mule
            family mob
        }
    }
    component_groups {
        group mule_adult {
            behavior.run_around_like_crazy priority=1 speed_multiplier=1.2
            experience_reward on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/horse.json"
        }
        group mule_baby {
            ageable {
                duration 1200
                feed_item growth=0.016667 item=wheat
                feed_item growth=0.025 item=sugar
                feed_item growth=0.15 item=hay_block
                feed_item growth=0.05 item=apple
                feed_item growth=0.05 item=carrot
                feed_item growth=0.05 item=golden_carrot
                feed_item growth=0.2 item=golden_apple
                feed_item growth=0.2 item=appleEnchanted
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=4 speed_multiplier=1.0
            is_baby
            scale_by_age end_scale=1.0 start_scale=0.5
        }
        group mule_chested {
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_family subject=other value=player
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            is_chested
        }
        group mule_saddled {
            behavior.player_ride_tamed
            can_power_jump
            input_ground_controlled
            is_saddled
        }
        group mule_tamed {
            equippable {
                slot {
                    accepted_item saddle
                    item saddle
                    on_equip {
                        event minecraft:mule_saddled
                    }
                    on_unequip {
                        event minecraft:mule_unsaddled
                    }
                    slot 0
                }
            }
            inventory container_type=horse inventory_size=16
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.975
                    seat -0.2
                }
            }
        }
        group mule_unchested {
            interact {
                interaction {
                    interact_text action.interact.attachchest
                    on_interact {
                        event minecraft:on_chest
                        filters {
                            filter test=has_equipment subject=other domain=hand value=chest
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                    use_item #true
                }
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
        }
        group mule_wild {
            behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
            rideable {
                family_type player
                family_type baby_zombie
                family_type baby_husk
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.975
                    seat -0.2
                }
            }
            tamemount {
                auto_reject_item item=horsearmorleather
                auto_reject_item item=horsearmoriron
                auto_reject_item item=horsearmorgold
                auto_reject_item item=horsearmordiamond
                auto_reject_item item=minecraft:copper_horse_armor
                auto_reject_item item=minecraft:netherite_horse_armor
                auto_reject_item item=saddle
                feed_item item=wheat temper_mod=3
                feed_item item=sugar temper_mod=3
                feed_item item=apple temper_mod=3
                feed_item item=carrot temper_mod=3
                feed_item item=golden_carrot temper_mod=5
                feed_item item=golden_apple temper_mod=10
                feed_item item=appleEnchanted temper_mod=10
                feed_text action.interact.feed
                max_temper 100
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:mule_adult
            add minecraft:mule_wild
            remove minecraft:mule_baby
        }
        event entity_born {
            add minecraft:mule_baby
        }
        event entity_spawned {
            randomize {
                option weight=80
                option weight=20
            }
        }
        event mule_saddled {
            add minecraft:mule_saddled
        }
        event mule_unsaddled {
            remove minecraft:mule_saddled
        }
        event on_chest {
            add minecraft:mule_chested
            remove minecraft:mule_unchested
        }
        event on_tame {
            add minecraft:mule_tamed
            add minecraft:mule_unchested
            remove minecraft:mule_wild
        }
        event spawn_adult {
            add minecraft:mule_adult
            add minecraft:mule_wild
        }
        event spawn_tame_adult {
            add minecraft:mule_adult
            add minecraft:mule_tamed
            add minecraft:mule_unchested
        }
    }
}
entity minecraft:nautilus {
    is_spawnable #true
