                    event minecraft:start_exploding_forced
                    filters {
                        filter test=is_family subject=other value=player
                        filter test=has_equipment subject=other domain=hand value=flint_and_steel
                        filter test=has_component operator="!=" value=minecraft:explode
                    }
                    target self
                }
                play_sounds ignite
                swing #true
            }
        }
        is_hidden_when_invisible
