        }
        group huntable_adult {
            type_family {
                family hoglin
                family hoglin_adult
                family hoglin_huntable
                family mob
            }
        }
        group hoglin_adult {
            attack {
                entry 3
                entry 9
            }
            behavior.breed priority=3 speed_multiplier=0.6
            behavior.hurt_by_target priority=2
            behavior.melee_box_attack cooldown_time=2 priority=4 speed_multiplier=1 track_target=#true
            breedable {
                breed_item crimson_fungus
                breeds_with {
                    baby_type minecraft:hoglin
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:hoglin
                }
                love_filters {
                    operator not
                    subject self
                    test has_component
                    value minecraft:attack_cooldown
                }
                require_tame #false
