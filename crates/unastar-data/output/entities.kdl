                require_tame #true
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/llama.json"
        }
        group llama_angry {
            angry {
                broadcast_anger #false
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 4
            }
            behavior.ranged_attack attack_radius=64 charge_charged_trigger=1 charge_shoot_trigger=2 priority=2
        }
        group llama_angry_wolf {
            angry {
                broadcast_anger #false
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration -1
            }
            behavior.ranged_attack attack_radius=64 charge_charged_trigger=1 charge_shoot_trigger=2 priority=2
        }
        group llama_baby {
            ageable {
                duration 1200
                feed_item growth=0.1 item=wheat
                feed_item growth=0.9 item=hay_block
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=5 speed_multiplier=1.0
            is_baby
            scale 0.5
        }
        group llama_brown {
            variant 2
        }
        group llama_chested {
            is_chested
        }
        group llama_creamy {
            variant 0
        }
        group llama_defend_trader {
            angry {
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 10
            }
            behavior.ranged_attack attack_radius=64 charge_charged_trigger=1 charge_shoot_trigger=2 priority=2
        }
        group llama_gray {
            variant 3
        }
        group llama_persistence {
            persistent
        }
        group llama_tamed {
            equippable {
                slot {
                    accepted_item carpet
                    item carpet
                    slot 1
                }
            }
            inventory additional_slots_per_strength=3 container_type=horse inventory_size=16
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.17
                    seat -0.3
                }
            }
        }
        group llama_unchested {
            interact {
                interaction {
                    interact_text action.interact.attachchest
                    on_interact {
                        event minecraft:on_chest
                        filters {
                            filter test=is_family subject=other value=player
                            filter test=has_equipment subject=other domain=hand value=chest
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                    use_item #true
                }
            }
        }
        group llama_unleashed {
            behavior.follow_caravan {
                entity_count 10
                entity_types {
                    filters test=is_family subject=other value=llama
                }
                priority 3
                speed_multiplier 2.1
            }
        }
        group llama_wandering_trader {
            environment_sensor {
                trigger {
                    event minecraft:on_tame
                    filters {
                        filter test=is_leashed subject=self value=#false
                        filter test=has_component subject=self operator="!=" value=minecraft:is_tamed
                    }
                }
                trigger {
                    event minecraft:remove_persistence
                    filters {
                        filter test=is_leashed subject=self value=#false
                        filter test=has_component subject=self operator="==" value=minecraft:persistent
                    }
                }
            }
            on_friendly_anger event=minecraft:defend_wandering_trader target=self
        }
        group llama_white {
            variant 1
        }
        group llama_wild {
            rideable {
                family_type player
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.17
                    seat -0.3
                }
            }
            tamemount {
                auto_reject_item item=horsearmorleather
                auto_reject_item item=horsearmoriron
                auto_reject_item item=horsearmorgold
                auto_reject_item item=horsearmordiamond
                auto_reject_item item=minecraft:copper_horse_armor
                auto_reject_item item=minecraft:netherite_horse_armor
                auto_reject_item item=saddle
                feed_item item=wheat temper_mod=3
                feed_item item=hay_block temper_mod=6
                feed_text action.interact.feed
                max_temper 30
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
        group strength_1 {
            strength 1 max=5
        }
        group strength_2 {
            strength 2 max=5
        }
        group strength_3 {
            strength 3 max=5
        }
        group strength_4 {
            strength 4 max=5
        }
        group strength_5 {
            strength 5 max=5
        }
    }
    events {
        event add_attributes
        event ageable_grow_up {
            add minecraft:llama_adult
            add minecraft:llama_wild
            remove minecraft:llama_baby
        }
        event become_angry {
            add minecraft:llama_angry
        }
        event defend_wandering_trader {
            add minecraft:llama_defend_trader
        }
        event entity_born {
            add minecraft:llama_baby
            add minecraft:llama_unleashed
        }
        event entity_spawned
        event from_wandering_trader
        event join_caravan {
            add minecraft:in_caravan
        }
        event leave_caravan {
            remove minecraft:in_caravan
        }
        event mad_at_wolf {
            add minecraft:llama_angry_wolf
        }
        event on_calm {
            remove minecraft:llama_angry
            remove minecraft:llama_angry_wolf
            remove minecraft:llama_defend_trader
        }
        event on_chest {
            add minecraft:llama_chested
            remove minecraft:llama_unchested
        }
        event on_leash {
            remove minecraft:llama_unleashed
        }
        event on_tame {
            add minecraft:llama_tamed
            add minecraft:llama_unchested
            remove minecraft:llama_wild
        }
        event on_unleash {
            add minecraft:llama_unleashed
        }
        event remove_persistence {
            remove minecraft:llama_persistence
        }
        event spawn_adult {
            add minecraft:llama_adult
            add minecraft:llama_wild
            add minecraft:llama_unleashed
            trigger minecraft:add_attributes
        }
        event spawn_baby {
            add minecraft:llama_baby
            add minecraft:llama_unleashed
            trigger minecraft:add_attributes
        }
    }
}
