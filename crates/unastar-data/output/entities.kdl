            despawn_from_distance
        }
        experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
        health 10
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable
        leashable_to
        movement 0.1
        movement.amphibious
        nameable
        navigation.generic avoid_damage_blocks=#true can_path_over_water=#true can_sink=#false can_swim=#true can_walk=#true is_amphibious=#true
        physics
        pushable
        type_family {
            family frog
            family mob
        }
        underwater_movement 0.15
    }
    component_groups {
        group cold_frog {
            variant 1
        }
        group pregnant {
            behavior.lay_egg {
                allow_laying_from_below #true
                egg_type minecraft:frog_spawn
                goal_radius 1.7
                lay_egg_sound lay_spawn
                lay_seconds 2
                on_lay {
                    event laid_egg
                    target self
                }
                priority 2
                search_height 3
                search_range 10
                speed_multiplier 1.0
                target_block minecraft:water
                entry Air
                use_default_animation #false
            }
            behavior.move_to_water goal_radius=1.5 priority=3 search_height=5 search_range=20
        }
        group temperate_frog {
            variant 0
        }
        group warm_frog {
            variant 2
        }
    }
    events {
        event become_pregnant {
            add pregnant
        }
        event laid_egg {
            remove pregnant
        }
        event entity_spawned
        event entity_transformed
        event spawn_cold {
            add cold_frog
        }
        event spawn_temperate {
            add temperate_frog
        }
        event spawn_warm {
            add warm_frog
        }
    }
}
