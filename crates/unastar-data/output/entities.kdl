                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=is_sitting subject=self
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            inventory container_type=horse
            leashable_to
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                pull_in_entities #true
                seat_count 2
                seat {
                    max_rider_count 2
                    min_rider_count 0
                    entry 0.0
                    entry 1.905
                    entry 0.5
                }
                seat {
                    max_rider_count 2
                    min_rider_count 1
                    entry 0.0
                    entry 1.905
                    entry -0.5
                }
            }
        }
        group camel_baby {
            ageable {
                duration 1200
                feed_items cactus
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=5 speed_multiplier=2.5
            is_baby
            scale 0.45
        }
        group camel_saddled {
            behavior.player_ride_tamed
            dash_action cooldown_time=2.75 horizontal_momentum=20.0 vertical_momentum=0.6
            input_ground_controlled
            is_saddled
        }
        group camel_sitting {
            collision_box height=0.945 width=1.7
            pushable is_pushable=#false is_pushable_by_piston=#true
        }
        group camel_standing {
            collision_box height=2.375 width=1.7
            pushable is_pushable=#true is_pushable_by_piston=#true
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:camel_adult
            remove minecraft:camel_baby
        }
        event camel_saddled {
            add minecraft:camel_saddled
        }
        event camel_unsaddled {
            remove minecraft:camel_saddled
        }
        event entity_born {
            add minecraft:camel_baby
            add minecraft:camel_standing
        }
        event entity_spawned {
            randomize {
                option weight=95 trigger=minecraft:spawn_adult
                option weight=5 trigger=minecraft:entity_born
            }
        }
        event spawn_adult {
            add minecraft:camel_adult
            add minecraft:camel_standing
        }
        event start_sitting {
            add minecraft:camel_sitting
            remove minecraft:camel_standing
        }
        event stop_sitting {
            add minecraft:camel_standing
            remove minecraft:camel_sitting
        }
    }
}
