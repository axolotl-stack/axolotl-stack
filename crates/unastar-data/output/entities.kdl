        behavior.panic prefer_water=#true priority=0 speed_multiplier=1.2
        behavior.random_swim interval=0 priority=7 xz_dist=30 y_dist=15
        behavior.tempt {
            can_tempt_vertically #true
            item seagrass
            priority 3
            speed_multiplier 1.1
        }
        breathable breathes_air=#true breathes_water=#true generates_bubbles=#false suffocate_time=0 total_supply=15
        collision_box height=1.8 width=0.6
