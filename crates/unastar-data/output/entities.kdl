entity minecraft:chicken {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    properties {
        climate_variant type=enum client_sync=#true {
            value temperate
            value warm
            value cold
            default temperate
        }
    }
    components {
        balloonable mass=0.5
        behavior.float priority=0
        behavior.look_at_player look_distance=6.0 priority=7 probability=0.02
        behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
        behavior.panic priority=1 speed_multiplier=1.5
        behavior.random_look_around priority=8
        behavior.random_stroll priority=6 speed_multiplier=1.0
        behavior.tempt {
            item wheat_seeds
            item beetroot_seeds
            item melon_seeds
            item pumpkin_seeds
            item pitcher_pod
            item torchflower_seeds
            priority 4
            speed_multiplier 1.0
        }
        breathable suffocate_time=0 total_supply=15
        can_climb
        collision_box height=0.8 width=0.6
        conditional_bandwidth_optimization
        damage_sensor {
            triggers {
                cause fall
                deals_damage no
            }
        }
        despawn {
            despawn_from_distance
        }
        game_event_movement_tracking emit_flap=#true
        health 4 max=4
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable
        movement 0.25
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true can_path_over_water=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family chicken
            family mob
        }
    }
    component_groups {
        group chicken_adult {
            behavior.breed priority=3 speed_multiplier=1.0
            breedable {
                breed_item wheat_seeds
                breed_item beetroot_seeds
                breed_item melon_seeds
                breed_item pumpkin_seeds
                breed_item pitcher_pod
                breed_item torchflower_seeds
                breeds_with {
                    baby_type minecraft:chicken
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:chicken
                }
                property_inheritance {
                    minecraft:climate_variant
                }
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/chicken.json"
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.48
                    seat 0.0
                }
            }
            spawn_entity {
                entitie {
                    filter operator="==" subject=self test=rider_count value=0
                    filter domain=minecraft:climate_variant subject=self test=enum_property value=temperate
                    max_wait_time 600
                    min_wait_time 300
                    spawn_item egg
                    spawn_sound plop
                }
                entitie {
                    filter operator="==" subject=self test=rider_count value=0
                    filter domain=minecraft:climate_variant subject=self test=enum_property value=warm
                    max_wait_time 600
                    min_wait_time 300
                    spawn_item brown_egg
                    spawn_sound plop
                }
                entitie {
                    filter operator="==" subject=self test=rider_count value=0
                    filter domain=minecraft:climate_variant subject=self test=enum_property value=cold
                    max_wait_time 600
                    min_wait_time 300
                    spawn_item blue_egg
                    spawn_sound plop
                }
            }
        }
        group chicken_baby {
            ageable {
                duration 1200
                feed_item wheat_seeds
                feed_item beetroot_seeds
                feed_item melon_seeds
                feed_item pumpkin_seeds
                feed_item pitcher_pod
                feed_item torchflower_seeds
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=5 speed_multiplier=1.1
            is_baby
            scale 0.5
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:chicken_adult
            remove minecraft:chicken_baby
        }
        event entity_born {
            add minecraft:chicken_baby
        }
        event entity_spawned
        event hatch_cold
        event hatch_warm
        event spawn_adult {
            add minecraft:chicken_adult
        }
    }
}
