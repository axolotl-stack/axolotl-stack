                    filter test=is_family subject=other value=magmacube
                    filter test=is_variant subject=other operator="==" value=1
                }
                max_dist 16
            }
            must_see #true
            priority 8
            within_radius 16
        }
        behavior.panic priority=1 speed_multiplier=2.0
