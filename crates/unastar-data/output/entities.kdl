                }
                trigger {
                    event minecraft:on_stop_riding_zombie_horse
                    filters {
                        filter test=is_vehicle_family operator=not value=zombiehorse
                        filter test=bool_property domain=minecraft:is_riding_zombie_horse
                    }
                }
            }
            timer {
                looping #false
                time 30
                time_down_event {
                    event minecraft:convert_to_drowned
                }
            }
        }
        group zombie_adult {
            behavior.mount_pathing priority=2 speed_multiplier=1.25 target_dist=0.0 track_target=#true
            experience_reward on_death="query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            movement 0.23
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    lock_rider_rotation 0
                    seat 0.0
                    seat 1.175
                    seat -0.35
                }
            }
        }
        group zombie_baby {
            experience_reward on_death="query.last_hit_by_player ? 12 + (query.equipment_count * Math.Random(1,3)) : 0"
            is_baby
            movement 0.35
            scale 0.5
            type_family {
                family baby_zombie
                family zombie
                family undead
                family monster
                family mob
            }
        }
        group zombie_default {
            loot table="loot_tables/entities/zombie.json"
        }
        group zombie_jockey {
            behavior.find_mount max_failed_attempts=20 priority=1 start_delay=15 within_radius=16
            loot table="loot_tables/entities/zombie.json"
        }
        group zombie_rider {
            equipment table="loot_tables/entities/zombie_rider_equipment.json"
            loot table="loot_tables/entities/zombie_rider.json"
            type_family {
                family zombie_rider
                family zombie
                family undead
                family monster
                family mob
            }
        }
    }
    events {
        event as_adult {
            add minecraft:zombie_default
            add minecraft:zombie_adult
            add minecraft:on_foot
            add minecraft:not_on_zombie_horse
            add minecraft:can_have_equipment
        }
        event as_baby {
            add minecraft:zombie_default
            add minecraft:zombie_baby
            add minecraft:on_foot
            add minecraft:not_on_zombie_horse
            add minecraft:can_have_equipment
        }
        event as_baby_jockey {
            add minecraft:zombie_baby
            add minecraft:zombie_jockey
            add minecraft:not_on_zombie_horse
            add minecraft:can_have_equipment
        }
        event convert_to_drowned
        event entity_spawned
        event on_start_riding_zombie_horse {
            add minecraft:on_zombie_horse
            remove minecraft:not_on_zombie_horse
        }
        event on_stop_riding_zombie_horse {
            add minecraft:not_on_zombie_horse
            remove minecraft:on_zombie_horse
        }
        event spawn_as_rider {
            add minecraft:zombie_adult
            add minecraft:zombie_rider
            add minecraft:on_zombie_horse
        }
        event start_transforming {
            add minecraft:start_drowned_transformation
            remove minecraft:look_to_start_drowned_transformation
        }
        event stop_transforming {
            add minecraft:look_to_start_drowned_transformation
            remove minecraft:start_drowned_transformation
        }
    }
}
entity minecraft:zombie_horse {
    spawn_category monster
