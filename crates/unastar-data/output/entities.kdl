        on_target_escape event=minecraft:stop_exploding target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        target_nearby_sensor {
            inside_range 2.5
            must_see #true
            on_inside_range {
                event minecraft:start_exploding
                target self
            }
            on_outside_range {
                event minecraft:stop_exploding
                target self
            }
            on_vision_lost_inside_range {
                event minecraft:stop_exploding
                target self
            }
            outside_range 6.0
        }
        type_family {
            family creeper
            family monster
            family mob
        }
    }
    component_groups {
        group charged_creeper {
            is_charged
        }
        group charged_exploding {
            explode causes_fire=#false destroy_affected_by_griefing=#true fuse_length=1.5 fuse_lit=#true power=6
        }
        group exploding {
            explode causes_fire=#false destroy_affected_by_griefing=#true fuse_length=1.5 fuse_lit=#true power=3
        }
        group forced_charged_exploding {
            explode causes_fire=#false destroy_affected_by_griefing=#true fuse_length=1.5 fuse_lit=#true power=6
            on_target_escape
            target_nearby_sensor
        }
        group forced_exploding {
            explode causes_fire=#false destroy_affected_by_griefing=#true fuse_length=1.5 fuse_lit=#true power=3
            on_target_escape
            target_nearby_sensor
        }
    }
    events {
        event become_charged {
            add minecraft:charged_creeper
            remove minecraft:exploding
        }
        event start_exploding
        event start_exploding_forced
        event stop_exploding {
            remove minecraft:exploding
        }
    }
}
