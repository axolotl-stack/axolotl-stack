                    event minecraft:on_stop_riding_camel_husk
                    filters {
                        filter test=is_vehicle_family operator=not value=camel_husk
                        filter test=bool_property domain=minecraft:is_riding_camel_husk
                    }
                }
            }
        }
        group not_on_camel_husk {
            behavior.use_kinetic_weapon {
                approach_distance 10.0
                cooldown_distance {
                    max 11.0
                    min 9.0
                }
                hijack_mount_navigation #true
                priority 3
                reposition_distance {
                    max 7.0
                    min 6.0
                }
                track_target #true
                weapon_min_speed_multiplier 0.2
                weapon_reach_multiplier 0.5
            }
        }
        group on_camel_husk {
            behavior.use_kinetic_weapon {
                approach_distance 12.0
                cooldown_distance {
                    max 13.0
                    min 11.0
                }
                cooldown_speed_multiplier 4.0
                hijack_mount_navigation #true
                priority 3
                reposition_distance {
                    max 9.0
                    min 8.0
                }
                reposition_speed_multiplier 4.0
                speed_multiplier 4.0
                track_target #true
                weapon_min_speed_multiplier 0.2
                weapon_reach_multiplier 0.5
            }
        }
        group start_zombie_transformation {
            environment_sensor {
                trigger {
                    event minecraft:stop_transforming
                    filters test=is_underwater value=#false
                }
                trigger {
                    event minecraft:on_start_riding_camel_husk
                    filters {
                        filter test=is_vehicle_family value=camel_husk
                        filter test=bool_property domain=minecraft:is_riding_camel_husk value=#false
                    }
                }
                trigger {
                    event minecraft:on_stop_riding_camel_husk
                    filters {
                        filter test=is_vehicle_family operator=not value=camel_husk
                        filter test=bool_property domain=minecraft:is_riding_camel_husk
                    }
                }
            }
            timer {
                looping #false
                time 30
                time_down_event {
                    event minecraft:convert_to_zombie
                }
            }
        }
        group zombie_husk_adult {
            behavior.mount_pathing priority=2 speed_multiplier=1.25 target_dist=0.0 track_target=#true
            experience_reward on_death="query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            movement 0.23
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    lock_rider_rotation 0
                    seat 0.0
                    seat 1.175
                    seat -0.35
                }
            }
        }
        group zombie_husk_baby {
            experience_reward on_death="query.last_hit_by_player ? 12 + (query.equipment_count * Math.Random(1,3)) : 0"
            is_baby
            movement 0.35
            scale 0.5
            type_family {
                family baby_husk
                family husk
                family zombie
                family undead
                family monster
                family mob
            }
        }
        group zombie_husk_jockey {
            behavior.find_mount priority=0 within_radius=16
        }
        group zombie_husk_rider {
            equipment table="loot_tables/entities/zombie_rider_equipment.json"
            loot table="loot_tables/entities/husk_rider.json"
            type_family {
                family husk_rider
                family husk
                family zombie
                family undead
                family monster
                family mob
            }
        }
    }
    events {
        event as_adult {
            add minecraft:zombie_husk_adult
            add minecraft:not_on_camel_husk
        }
        event as_baby {
            add minecraft:zombie_husk_baby
            add minecraft:not_on_camel_husk
        }
        event as_baby_jockey {
            add minecraft:zombie_husk_baby
            add minecraft:zombie_husk_jockey
            add minecraft:not_on_camel_husk
        }
        event convert_to_zombie
        event entity_spawned
        event on_start_riding_camel_husk {
            add minecraft:on_camel_husk
            remove minecraft:not_on_camel_husk
        }
        event on_stop_riding_camel_husk {
            add minecraft:not_on_camel_husk
            remove minecraft:on_camel_husk
        }
        event spawn_as_rider {
            add minecraft:zombie_husk_adult
            add minecraft:zombie_husk_rider
            add minecraft:on_camel_husk
        }
        event start_transforming {
            add minecraft:start_zombie_transformation
            remove minecraft:look_to_start_zombie_transformation
        }
        event stop_transforming {
            add minecraft:look_to_start_zombie_transformation
            remove minecraft:start_zombie_transformation
        }
    }
}
