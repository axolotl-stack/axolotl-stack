            behavior.nearest_prioritized_attackable_target {
                attack_interval 2
                entity_type {
                    filters test=is_family subject=other value=rabbit
                    max_dist 12
                    priority 1
                }
                entity_type {
                    filters test=is_family subject=other value=chicken
                    max_dist 12
                    priority 1
                }
                entity_type {
                    filters test=is_family subject=other value=cod
                    max_dist 12
                    priority 0
                }
                entity_type {
                    filters test=is_family subject=other value=salmon
                    max_dist 12
                    priority 0
                }
                entity_type {
                    filters test=is_family subject=other value=tropicalfish
                    max_dist 12
                    priority 0
                }
                entity_type {
                    filters {
                        filter test=is_family subject=other value=baby_turtle
                        filter test=in_water subject=other operator="!=" value=#true
                    }
                    max_dist 12
                    priority 1
                }
                priority 6
                reselect_targets #true
                target_search_height 5
            }
            variant 1
        }
        group fox_baby {
            ageable {
                duration 1200
                feed_item sweet_berries
                feed_item glow_berries
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=9 speed_multiplier=1.1
            is_baby
            scale 0.5
        }
        group fox_day {
            behavior.find_cover cooldown_time=5.0 priority=9 speed_multiplier=1
            behavior.nap {
                can_nap_filters {
                    filter operator="==" subject=self test=in_water value=#false
                    filter operator="==" subject=self test=on_ground value=#true
                    filter operator="==" subject=self test=is_underground value=#true
                    filter operator="!=" subject=self test=weather_at_position value=thunderstorm
                }
                cooldown_max 7.0
                cooldown_min 2.0
                mob_detect_dist 12.0
                mob_detect_height 6.0
                priority 8
                wake_mob_exceptions {
                    filter operator="==" subject=other test=trusts value=#true
                    filter operator="==" subject=other test=is_family value=fox
                    filter operator="==" subject=other test=is_sneaking value=#true
                }
            }
            environment_sensor {
                trigger {
                    event minecraft:fox_configure_thunderstorm
                    filters test=weather_at_position value=thunderstorm
                }
                trigger {
                    event minecraft:fox_configure_night
                    filters test=is_daytime value=#false
                }
            }
        }
        group fox_night {
            behavior.stroll_towards_village cooldown_time=10.0 goal_radius=3.0 priority=11 search_range=32 speed_multiplier=1.0 start_chance=0.005
            environment_sensor {
                trigger {
                    event minecraft:fox_configure_thunderstorm
                    filters test=weather_at_position value=thunderstorm
                }
                trigger {
                    event minecraft:fox_configure_day
                    filters test=is_daytime value=#true
                }
            }
        }
        group fox_red {
            behavior.nearest_prioritized_attackable_target {
                attack_interval 2
                entity_type {
                    filters test=is_family subject=other value=rabbit
                    max_dist 12
                    priority 0
                }
                entity_type {
                    filters test=is_family subject=other value=chicken
                    max_dist 12
                    priority 0
                }
                entity_type {
                    filters test=is_family subject=other value=cod
                    max_dist 12
                    priority 1
                }
                entity_type {
                    filters test=is_family subject=other value=salmon
                    max_dist 12
                    priority 1
                }
                entity_type {
                    filters test=is_family subject=other value=tropicalfish
                    max_dist 12
                    priority 1
                }
                entity_type {
                    filters {
                        filter test=is_family subject=other value=baby_turtle
                        filter test=in_water subject=other operator="!=" value=#true
                    }
                    max_dist 12
                    priority 0
                }
                priority 6
                reselect_targets #true
                target_search_height 5
            }
            variant 0
        }
        group fox_thunderstorm {
            behavior.find_cover cooldown_time=0.0 priority=0 speed_multiplier=1
            environment_sensor {
                trigger {
                    event minecraft:fox_configure_day
                    filters {
                        filter test=weather_at_position operator="!=" value=thunderstorm
                        filter test=is_daytime value=#true
                    }
                }
                trigger {
                    event minecraft:fox_configure_night
                    filters {
                        filter test=weather_at_position operator="!=" value=thunderstorm
                        filter test=is_daytime value=#false
                    }
                }
            }
        }
        group fox_with_item {
            equipment {
                entry drop_chance=1.0 slot=slot.weapon.mainhand
                table "loot_tables/entities/fox_equipment.json"
            }
        }
        group trusting_fox {
            behavior.defend_trusted_target {
                aggro_sound mad
                must_see #false
                on_defend_start {
                    event minecraft:fox_configure_defending
                    target self
                }
                priority 0
                sound_chance 0.05
                within_radius 25
            }
            trust
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:fox_adult
            remove minecraft:fox_baby
        }
        event ambient_night {
            add minecraft:fox_ambient_night
        }
        event ambient_normal {
            add minecraft:fox_ambient_normal
        }
        event ambient_sleep {
            add minecraft:fox_ambient_sleep
        }
        event entity_born {
            add minecraft:fox_baby
            add minecraft:trusting_fox
            add minecraft:docile_fox
        }
        event entity_spawned
        event fox_configure_day {
            add minecraft:fox_day
            remove minecraft:fox_night
            remove minecraft:fox_thunderstorm
        }
        event fox_configure_defending {
            add minecraft:defending_fox
            add minecraft:fox_ambient_defending_target
            remove minecraft:docile_fox
            remove minecraft:fox_day
            remove minecraft:fox_night
        }
        event fox_configure_docile_day {
            add minecraft:docile_fox
            add minecraft:fox_day
            remove minecraft:defending_fox
            remove minecraft:fox_night
        }
        event fox_configure_docile_night {
            add minecraft:docile_fox
            add minecraft:fox_night
            remove minecraft:defending_fox
            remove minecraft:fox_day
        }
        event fox_configure_night {
            add minecraft:fox_night
            remove minecraft:fox_day
            remove minecraft:fox_thunderstorm
        }
        event fox_configure_thunderstorm {
            add minecraft:fox_thunderstorm
            remove minecraft:fox_night
            remove minecraft:fox_day
        }
    }
}
entity minecraft:frog {
    spawn_category creature
