                feed_item growth=0.05 item=golden_carrot
                feed_item growth=0.2 item=golden_apple
                feed_item growth=0.2 item=appleEnchanted
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=4 speed_multiplier=1.0
            is_baby
            scale_by_age end_scale=1.0 start_scale=0.5
        }
        group horse_saddled {
            behavior.player_ride_tamed
            can_power_jump
            input_ground_controlled
            is_saddled
        }
        group horse_tamed {
            breedable {
                breed_item golden_carrot
                breed_item golden_apple
                breed_item appleEnchanted
                entry {
                    baby_type minecraft:horse
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:horse
                }
                entry {
                    baby_type minecraft:mule
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:donkey
                }
                inherit_tamed #false
                mutation_factor {
                    extra_variant 0.2
                    variant 0.111
                }
                mutation_strategy random
                entry minecraft:health
                entry minecraft:movement
                entry minecraft:horse.jump_strength
                entry 0
                entry 5
                entry 0
                entry 7
                require_tame #true
            }
            interact {
                interaction {
                    equip_item_slot "1"
                    interact_text action.interact.equiphorsearmor
                    on_interact {
                        filters {
                            filter test=has_equipment_tag subject=self operator=not domain=inventory value=minecraft:horse_armor
                            filter test=has_equipment_tag subject=player domain=hand value=minecraft:horse_armor
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "1"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removehorsearmor
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment_tag subject=self domain=inventory value=minecraft:horse_armor
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds armor.unequip_generic
                    vibration shear
                }
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds saddle
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            inventory container_type=horse inventory_size=2
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.1
                    seat -0.2
                }
            }
        }
        group horse_wild {
            behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
            rideable {
                family_type player
                family_type baby_zombie
                family_type baby_husk
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.1
                    seat -0.2
                }
            }
            tamemount {
                auto_reject_item item=horsearmorleather
                auto_reject_item item=horsearmoriron
                auto_reject_item item=horsearmorgold
                auto_reject_item item=horsearmordiamond
                auto_reject_item item=minecraft:copper_horse_armor
                auto_reject_item item=minecraft:netherite_horse_armor
                auto_reject_item item=saddle
                feed_item item=wheat temper_mod=3
                feed_item item=sugar temper_mod=3
                feed_item item=apple temper_mod=3
                feed_item item=carrot temper_mod=3
                feed_item item=golden_carrot temper_mod=5
                feed_item item=golden_apple temper_mod=10
                feed_item item=appleEnchanted temper_mod=10
                feed_text action.interact.feed
                max_temper 100
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
        group markings_black_dots {
            mark_variant 4
        }
        group markings_none {
            mark_variant 0
        }
        group markings_white_details {
            mark_variant 1
        }
        group markings_white_dots {
            mark_variant 3
        }
        group markings_white_fields {
            mark_variant 2
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:horse_adult
            add minecraft:horse_wild
            remove minecraft:horse_baby
        }
        event entity_born {
            add minecraft:horse_baby
        }
        event entity_spawned
        event horse_saddled {
            add minecraft:horse_saddled
        }
        event horse_unsaddled {
            remove minecraft:horse_saddled
        }
        event make_black {
            add minecraft:base_black
        }
        event make_brown {
            add minecraft:base_brown
        }
        event make_chestnut {
            add minecraft:base_chestnut
        }
        event make_creamy {
            add minecraft:base_creamy
        }
        event make_darkbrown {
            add minecraft:base_darkbrown
        }
        event make_gray {
            add minecraft:base_gray
        }
        event make_white {
            add minecraft:base_white
        }
        event on_tame {
            add minecraft:horse_tamed
            remove minecraft:horse_wild
        }
        event spawn_adult {
            add minecraft:horse_adult
            add minecraft:horse_wild
        }
        event spawn_tame_adult {
            add minecraft:horse_adult
            add minecraft:horse_tamed
        }
    }
}
