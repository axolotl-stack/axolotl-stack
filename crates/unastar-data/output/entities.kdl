entity minecraft:llama {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    components {
        balloonable
        behavior.float priority=0
        behavior.hurt_by_target hurt_owner=#true priority=1
        behavior.look_at_player look_distance=6.0 priority=7 probability=0.02
        behavior.mount_pathing priority=1 speed_multiplier=1.25 target_dist=0.0 track_target=#true
        behavior.nearest_attackable_target {
            attack_interval 16
            entity_type {
                filters {
                    filter test=is_family subject=other value=wolf
                    filter test=has_component subject=other operator="!=" value=minecraft:is_tamed
                }
                max_dist 10
            }
            must_reach #true
            must_see #false
            priority 2
        }
        behavior.panic priority=4 speed_multiplier=1.2
        behavior.random_look_around priority=8
        behavior.random_stroll priority=6 speed_multiplier=0.7
        behavior.run_around_like_crazy priority=1 speed_multiplier=1.2
        behavior.tempt {
            item hay_block
            priority 5
            speed_multiplier 1.2
        }
        breathable suffocate_time=0 total_supply=15
        collision_box height=1.87 width=0.9
        conditional_bandwidth_optimization
        damage_sensor {
            triggers {
                cause all
                deals_damage yes
                on_damage {
                    event minecraft:become_angry
                    filters test=in_caravan value=#false
                }
            }
        }
        despawn {
            despawn_from_distance
        }
        follow_range 40 max=40
        healable {
            item heal_amount=2 item=wheat
            item heal_amount=10 item=hay_block
        }
        health {
            value {
                range_max 30
                range_min 15
            }
        }
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable {
            on_leash {
                event minecraft:on_leash
                target self
            }
            on_unleash {
                event minecraft:on_unleash
                target self
            }
        }
        mark_variant 0
        movement 0.25
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true can_path_over_water=#true
        on_target_acquired {
            event minecraft:mad_at_wolf
            filters {
                filter test=is_family subject=target value=wolf
                filter test=has_component subject=target operator="!=" value=minecraft:is_tamed
            }
            target self
        }
        on_target_escape {
            event minecraft:on_calm
            filters {
                filter test=is_family subject=target value=wolf
                filter test=has_component subject=target operator="!=" value=minecraft:is_tamed
            }
            target self
        }
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        shooter def=minecraft:llama_spit
        type_family {
            family llama
            family mob
        }
    }
    component_groups {
        group in_caravan {
            damage_sensor {
                triggers {
                    cause all
                    deals_damage yes
                }
            }
        }
        group llama_adult {
            behavior.breed priority=4 speed_multiplier=1.0
            breedable {
                breed_item hay_block
                breeds_with {
                    baby_type minecraft:llama
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:llama
                }
                inherit_tamed #false
                entry minecraft:health
                require_tame #true
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/llama.json"
        }
        group llama_angry {
            angry {
                broadcast_anger #false
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 4
            }
            behavior.ranged_attack attack_radius=64 charge_charged_trigger=1 charge_shoot_trigger=2 priority=2
        }
        group llama_angry_wolf {
            angry {
                broadcast_anger #false
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration -1
            }
            behavior.ranged_attack attack_radius=64 charge_charged_trigger=1 charge_shoot_trigger=2 priority=2
        }
        group llama_baby {
            ageable {
                duration 1200
                feed_item growth=0.1 item=wheat
                feed_item growth=0.9 item=hay_block
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=5 speed_multiplier=1.0
            is_baby
            scale 0.5
        }
        group llama_brown {
            variant 2
        }
        group llama_chested {
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.equipcarpet
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=carpet
                            filter test=has_equipment subject=other domain=hand value=carpet
                            filter test=is_family subject=other value=player
                            filter test=is_sneaking subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removecarpet
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=carpet
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            is_chested
        }
        group llama_creamy {
            variant 0
        }
        group llama_gray {
            variant 3
        }
        group llama_tamed {
            equippable {
                slot {
                    accepted_item carpet
                    item carpet
                    slot 1
                }
            }
            inventory additional_slots_per_strength=3 container_type=horse inventory_size=16
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.17
                    seat -0.3
                }
            }
        }
        group llama_unchested {
            interact {
                interaction {
                    interact_text action.interact.attachchest
                    on_interact {
                        event minecraft:on_chest
                        filters {
                            filter test=is_family subject=other value=player
                            filter test=is_sneaking subject=other value=#false
                            filter test=has_equipment subject=other domain=hand value=chest
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                    use_item #true
                }
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.equipcarpet
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=carpet
                            filter test=has_equipment subject=other domain=hand value=carpet
                            filter test=is_sneaking subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removecarpet
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=carpet
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds armor.unequip_generic
                    vibration shear
                }
            }
        }
        group llama_unleashed {
            behavior.follow_caravan {
                entity_count 10
                entity_types {
                    filters test=is_family subject=other value=llama
                }
                priority 3
                speed_multiplier 2.1
            }
        }
        group llama_white {
            variant 1
        }
        group llama_wild {
            rideable {
                family_type player
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.17
                    seat -0.3
                }
            }
            tamemount {
                feed_item item=wheat temper_mod=3
                feed_item item=hay_block temper_mod=6
                feed_text action.interact.feed
                max_temper 30
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
        group strength_1 {
            strength 1 max=5
        }
        group strength_2 {
            strength 2 max=5
        }
        group strength_3 {
            strength 3 max=5
        }
        group strength_4 {
            strength 4 max=5
        }
        group strength_5 {
            strength 5 max=5
        }
    }
    events {
        event add_attributes
        event ageable_grow_up {
            add minecraft:llama_adult
            add minecraft:llama_wild
            remove minecraft:llama_baby
        }
        event become_angry {
            add minecraft:llama_angry
        }
        event entity_born {
            add minecraft:llama_baby
        }
        event entity_spawned
        event join_caravan {
            add minecraft:in_caravan
        }
        event leave_caravan {
            remove minecraft:in_caravan
        }
        event mad_at_wolf {
            add minecraft:llama_angry_wolf
        }
        event on_calm {
            remove minecraft:llama_angry
            remove minecraft:llama_angry_wolf
        }
        event on_chest {
            add minecraft:llama_chested
            remove minecraft:llama_unchested
        }
        event on_leash {
            remove minecraft:llama_unleashed
        }
        event on_tame {
            add minecraft:llama_tamed
            add minecraft:llama_unchested
            remove minecraft:llama_wild
        }
        event on_unleash {
            add minecraft:llama_unleashed
        }
        event spawn_adult {
            add minecraft:llama_adult
            add minecraft:llama_wild
            add minecraft:llama_unleashed
            trigger minecraft:add_attributes
        }
        event spawn_baby {
            add minecraft:llama_baby
            add minecraft:llama_unleashed
            trigger minecraft:add_attributes
        }
        event spawn_tame_adult {
            add minecraft:llama_adult
            add minecraft:llama_tamed
            add minecraft:llama_unchested
            add minecraft:llama_unleashed
            trigger minecraft:add_attributes
        }
    }
}
