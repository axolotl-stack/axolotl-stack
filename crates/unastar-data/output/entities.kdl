                    range_max 5.0
                    range_min 2.0
                }
            }
        }
        group attack_cooldown {
            attack_cooldown {
                attack_cooldown_complete_event {
                    event attack_cooldown_complete_event
                    target self
                }
                entry 30.0
                entry 120.0
            }
        }
