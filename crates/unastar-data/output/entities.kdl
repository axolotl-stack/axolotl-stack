                breed_item item=pufferfish_bucket result_item=water_bucket:0
                breed_item item=cod_bucket result_item=water_bucket:0
                breed_item item=salmon_bucket result_item=water_bucket:0
                breed_item item=tropical_fish_bucket result_item=water_bucket:0
                breed_item pufferfish
                breed_item fish
                breed_item salmon
                breed_item clownfish
                breed_item cooked_fish
                breed_item cooked_salmon
                breeds_with {
                    baby_type minecraft:nautilus
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:nautilus
                }
                require_tame #true
            }
            collision_box height=0.95 width=0.875
            leashable_to
        }
        group nautilus_ai_controlled {
            movement 0.15
            underwater_movement 0.07
        }
        group nautilus_baby {
            ageable {
                duration 1200
                feed_item item=pufferfish_bucket result_item=water_bucket:0
                feed_item item=cod_bucket result_item=water_bucket:0
                feed_item item=salmon_bucket result_item=water_bucket:0
                feed_item item=tropical_fish_bucket result_item=water_bucket:0
                feed_item pufferfish
                feed_item fish
                feed_item salmon
                feed_item clownfish
                feed_item cooked_fish
                feed_item cooked_salmon
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.panic priority=1 speed_multiplier=1.6
            behavior.tempt {
                item pufferfish_bucket
                item cod_bucket
                item salmon_bucket
                item tropical_fish_bucket
                item pufferfish
                item fish
                item salmon
                item clownfish
                item cooked_fish
                item cooked_salmon
                on_tempt_end {
                    event minecraft:on_stop_tempting
                }
                priority 4
                speed_multiplier 2
            }
            collision_box height=0.5 width=0.44
            is_baby
            movement 0.15
            underwater_movement 0.15
        }
        group nautilus_charging {
            underwater_movement 0.12
        }
        group nautilus_leashable {
            leashable {
                on_unleash {
                    event minecraft:on_unleashed
                    target self
                }
                preset hard_distance=10 max_distance=14
            }
        }
        group nautilus_player_controlled {
            movement 0.015
            underwater_movement 0.055
        }
        group nautilus_tame {
            behavior.panic priority=1 speed_multiplier=1.6
            behavior.tempt {
                item pufferfish_bucket
                item cod_bucket
                item salmon_bucket
                item tropical_fish_bucket
                item pufferfish
                item fish
                item salmon
                item clownfish
                item cooked_fish
                item cooked_salmon
                on_tempt_end {
                    event minecraft:on_stop_tempting
                }
                priority 4
                speed_multiplier 2
            }
            healable {
                item heal_amount=2 item=pufferfish_bucket result_item=water_bucket:0
                item heal_amount=4 item=cod_bucket result_item=water_bucket:0
                item heal_amount=4 item=salmon_bucket result_item=water_bucket:0
                item heal_amount=2 item=tropical_fish_bucket result_item=water_bucket:0
                item heal_amount=4 item=fish
                item heal_amount=4 item=salmon
                item heal_amount=2 item=clownfish
                item heal_amount=2 item=pufferfish
                item heal_amount=10 item=cooked_fish
                item heal_amount=12 item=cooked_salmon
            }
            is_tamed
        }
        group nautilus_tame_adult {
            equippable {
                slot {
                    accepted_item saddle
                    item saddle
                    on_equip {
                        event minecraft:on_saddled
                    }
                    on_unequip {
                        event minecraft:on_unsaddled
                    }
                    slot 0
                }
                slot {
                    accepted_item minecraft:copper_nautilus_armor
                    accepted_item minecraft:iron_nautilus_armor
                    accepted_item minecraft:golden_nautilus_armor
                    accepted_item minecraft:diamond_nautilus_armor
                    accepted_item minecraft:netherite_nautilus_armor
                    item nautilusarmor
                    slot 1
                }
            }
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds saddle
                }
                interaction {
                    equip_item_slot "1"
                    interact_text action.interact.equipnautilusarmor
                    on_interact {
                        filters {
                            filter test=has_equipment_tag subject=self operator=not domain=inventory value=minecraft:nautilus_armor
                            filter test=has_equipment_tag subject=player domain=hand value=minecraft:nautilus_armor
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "1"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removenautilusarmor
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment_tag subject=self domain=inventory value=minecraft:nautilus_armor
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds armor.unequip_generic
                    vibration shear
                }
                interaction {
                    drop_item_slot "0"
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            inventory container_type=horse
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                on_rider_enter_event minecraft:on_mount
                on_rider_exit_event minecraft:on_dismount
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.925
                    seat 0.0
                    third_person_camera_radius 7.0
                }
            }
        }
        group nautilus_tame_saddled {
            behavior.player_ride_tamed priority=0
            environment_sensor {
                trigger {
                    event minecraft:on_saddled_in_water
                    filters test=in_water operator="==" value=#true
                }
                trigger {
                    event minecraft:on_saddled_out_of_water
                    filters test=in_water operator="==" value=#false
                }
            }
            home restriction_radius=16 restriction_type=random_movement
            is_saddled
        }
        group nautilus_tame_saddled_in_water {
            dash_action can_dash_underwater=#true cooldown_time=2 direction=passenger horizontal_momentum=154.0 vertical_momentum=0.1
            environment_sensor {
                trigger {
                    event minecraft:on_saddled_out_of_water
                    filters test=in_water operator="==" value=#false
                }
            }
            free_camera_controlled backwards_movement_modifier=0.5 strafe_speed_modifier=0.7
            mob_effect {
                ambient #true
                effect_range 1.6
                effect_time 2
                entity_filter {
                    filter subject=other test=is_family value=player
                    filter subject=other test=is_riding_self
                }
                mob_effect breath_of_the_nautilus
            }
            underwater_mount_breathing
        }
        group nautilus_tame_saddled_on_ground {
            dash_action can_dash_underwater=#false cooldown_time=2 direction=passenger horizontal_momentum=42.0 vertical_momentum=0.1
            environment_sensor {
                trigger {
                    event minecraft:on_saddled_in_water
                    filters test=in_water operator="==" value=#true
                }
            }
            input_ground_controlled
        }
        group nautilus_tame_unsaddled {
            home restriction_radius=32 restriction_type=random_movement
        }
        group nautilus_wild_adult_angry {
            angry {
                broadcast_anger #false
                broadcast_anger_when_dying #false
                broadcast_range 16
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 20
            }
            behavior.aquatic_charge_attack {
                attack_reach 0.0
                charge_cooldown_time {
                    max 4.0
                    min 4.0
                }
                charge_overshoot_distance 1.5
                charge_speed_multiplier 10.0
                knockback_force 2.0
                max_charge_distance 16
                priority 3
            }
        }
        group nautilus_wild_adult_calm {
            behavior.nearest_attackable_target {
                attack_interval {
                    range_max 180.0
                    range_min 120.0
                }
                entity_type {
                    filters {
                        any_of {
                            filter test=is_family subject=other value=pufferfish
                        }
                    }
                    max_dist 35
                }
                must_see #true
                must_see_forget_duration 17.0
                priority 5
                reselect_targets #true
                target_acquisition_probability 0.5
                within_radius 25.0
            }
            behavior.tempt {
                item pufferfish
                item pufferfish_bucket
                on_tempt_end {
                    event minecraft:on_stop_tempting
                }
                priority 4
                speed_multiplier 2
            }
            on_target_acquired event=minecraft:become_angry target=self
            tameable {
                probability 0.33
                tame_event {
                    event minecraft:on_tame
                    target self
                }
                tame_item item=pufferfish_bucket result_item=water_bucket:0
                tame_item pufferfish
            }
        }
    }
    events {
        event ageable_grow_up
        event become_angry {
            add minecraft:nautilus_wild_adult_angry
            remove minecraft:nautilus_wild_adult_calm
            remove minecraft:nautilus_leashable
        }
        event entity_born {
            trigger minecraft:spawn_tame_baby
        }
        event entity_spawned {
            randomize {
                option weight=90 trigger=minecraft:spawn_wild_adult
                option weight=10 trigger=minecraft:spawn_wild_baby
            }
        }
        event on_calm {
            add minecraft:nautilus_wild_adult_calm
            add minecraft:nautilus_leashable
            remove minecraft:nautilus_wild_adult_angry
        }
        event on_dismount {
            trigger minecraft:switch_to_ai_controlled
        }
        event on_mount {
            trigger minecraft:switch_to_player_controlled
        }
        event on_saddled
        event on_saddled_in_water {
            add minecraft:nautilus_tame_saddled_in_water
            remove minecraft:nautilus_tame_saddled_on_ground
        }
        event on_saddled_out_of_water {
            add minecraft:nautilus_tame_saddled_on_ground
            remove minecraft:nautilus_tame_saddled_in_water
        }
        event on_stop_tempting
        event on_tame
        event on_unleashed
        event on_unsaddled
        event spawn_tame_baby {
            add minecraft:nautilus_baby
            add minecraft:nautilus_tame
            add minecraft:nautilus_tame_unsaddled
            add minecraft:nautilus_leashable
        }
        event spawn_wild_adult {
            add minecraft:nautilus_adult
            add minecraft:nautilus_wild_adult_calm
            add minecraft:nautilus_ai_controlled
            add minecraft:nautilus_leashable
        }
        event spawn_wild_baby {
            add minecraft:nautilus_baby
            add minecraft:nautilus_leashable
        }
        event start_charge {
            add minecraft:nautilus_charging
        }
        event stop_charge {
            remove minecraft:nautilus_charging
        }
        event switch_to_ai_controlled {
            add minecraft:nautilus_ai_controlled
            remove minecraft:nautilus_player_controlled
        }
        event switch_to_player_controlled {
            add minecraft:nautilus_player_controlled
            remove minecraft:nautilus_ai_controlled
        }
    }
}
