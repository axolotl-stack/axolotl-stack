                    filter test=in_water value=#false
                }
                filter {
                    any_of {
                        filter test=on_ground value=#true
                        filter test=is_sleeping value=#true
                    }
                }
            }
            priority 1
        }
        breathable suffocate_time=0 total_supply=15
        can_climb
        collision_box height=1.9 width=0.6
        conditional_bandwidth_optimization
        damage_sensor {
            trigger {
                deals_damage #false
                on_damage {
                    event become_witch
                    filters test=is_family subject=other value=lightning
                }
            }
            trigger {
                on_damage {
                    event become_zombie
                    filters {
                        filter test=has_damage value=fatal
                    }
                }
            }
        }
        health 20 max=20
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        inventory inventory_size=8 private=#true
        is_hidden_when_invisible
        jump.static
        movement 0.5
        movement.basic
        nameable
        navigation.walk avoid_water=#true can_open_doors=#true can_pass_doors=#true can_path_over_water=#true can_walk=#true is_amphibious=#true
        persistent
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family villager
            family mob
        }
    }
    component_groups {
        group adult {
            behavior.make_love priority=6
            behavior.receive_love priority=7
        }
        group armorer {
            trade_table convert_trades_economy=#true display_name=entity.villager.armor table="trading/armorer_trades.json"
            type_family {
                family villager
                family blacksmith
                family armorer
                family mob
            }
            variant 3
        }
        group baby {
            ageable {
                duration 1200
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.play priority=8 speed_multiplier=0.32
            behavior.take_flower {
                filters {
                    filter test=is_daytime value=#true
                }
                priority 7
            }
            is_baby
            scale 0.5
        }
        group become_villager_v2 {
            transformation into=minecraft:villager_v2 keep_level=#true
        }
        group become_witch {
            transformation delay=0.5 into=minecraft:witch
        }
        group become_zombie {
            transformation into=minecraft:zombie_villager
        }
        group behavior_non_peasant {
            shareables {
                item item=minecraft:bread stored_in_inventory=#true surplus_amount=6 want_amount=3
                item item=minecraft:carrot stored_in_inventory=#true surplus_amount=24 want_amount=12
                item item=minecraft:potato stored_in_inventory=#true surplus_amount=24 want_amount=12
                item item=minecraft:beetroot stored_in_inventory=#true surplus_amount=24 want_amount=12
            }
        }
        group behavior_peasant {
            behavior.harvest_farm_block priority=9 speed_multiplier=0.5
            shareables {
                item item=minecraft:bread stored_in_inventory=#true surplus_amount=6 want_amount=3
                item item=minecraft:carrot stored_in_inventory=#true surplus_amount=4 want_amount=60
                item item=minecraft:potato stored_in_inventory=#true surplus_amount=24 want_amount=60
                item item=minecraft:beetroot stored_in_inventory=#true surplus_amount=24 want_amount=60
                item item=minecraft:wheat_seeds pickup_only=#true stored_in_inventory=#true surplus_amount=64 want_amount=64
                item item=minecraft:beetroot_seeds pickup_only=#true stored_in_inventory=#true surplus_amount=64 want_amount=64
                item craft_into=minecraft:bread item=minecraft:wheat stored_in_inventory=#true surplus_amount=18 want_amount=45
            }
        }
        group butcher {
            trade_table convert_trades_economy=#true display_name=entity.villager.butcher table="trading/butcher_trades.json"
            type_family {
                family villager
                family artisan
                family butcher
                family mob
            }
            variant 4
        }
        group cartographer {
            trade_table convert_trades_economy=#true display_name=entity.villager.cartographer table="trading/cartographer_trades.json"
            type_family {
                family villager
                family cartographer
                family mob
            }
            variant 1
        }
        group cleric {
            trade_table convert_trades_economy=#true display_name=entity.villager.cleric table="trading/cleric_trades.json"
            type_family {
                family villager
                family priest
                family cleric
                family mob
            }
            variant 2
        }
        group farmer {
            trade_table convert_trades_economy=#true display_name=entity.villager.farmer table="trading/farmer_trades.json"
            type_family {
                family villager
                family peasant
                family farmer
                family mob
            }
            variant 0
        }
        group fisherman {
            trade_table convert_trades_economy=#true display_name=entity.villager.fisherman table="trading/fisherman_trades.json"
            type_family {
                family villager
                family peasant
                family fisherman
                family mob
            }
            variant 0
        }
        group fletcher {
            trade_table convert_trades_economy=#true display_name=entity.villager.fletcher table="trading/fletcher_trades.json"
            type_family {
                family villager
                family peasant
                family fletcher
                family mob
            }
            variant 0
        }
        group leatherworker {
            trade_table convert_trades_economy=#true display_name=entity.villager.leather table="trading/leather_worker_trades.json"
            type_family {
                family villager
                family artisan
                family leatherworker
                family mob
            }
            variant 4
        }
        group librarian {
            trade_table convert_trades_economy=#true display_name=entity.villager.librarian table="trading/librarian_trades.json"
            type_family {
                family villager
                family librarian
                family mob
            }
            variant 1
        }
        group celebrate {
            behavior.celebrate_survive {
                duration 30.0
                fireworks_interval {
                    range_max 7.0
                    range_min 2.0
                }
                on_celebration_end_event {
                    event minecraft:stop_celebrating
                    target self
                }
                priority 5
            }
            behavior.move_outdoors priority=2 speed_multiplier=0.8 timeout_cooldown=8.0
        }
        group shepherd {
            trade_table convert_trades_economy=#true display_name=entity.villager.shepherd table="trading/shepherd_trades.json"
            type_family {
                family villager
                family peasant
                family shepherd
                family mob
            }
            variant 0
        }
        group toolsmith {
            trade_table convert_trades_economy=#true display_name=entity.villager.tool table="trading/tool_smith_trades.json"
            type_family {
                family villager
                family blacksmith
                family toolsmith
                family mob
            }
            variant 3
        }
        group weaponsmith {
            trade_table convert_trades_economy=#true display_name=entity.villager.weapon table="trading/weapon_smith_trades.json"
            type_family {
                family villager
                family blacksmith
                family weaponsmith
                family mob
            }
            variant 3
        }
    }
    events {
        event become_witch {
            add become_witch
        }
        event become_zombie
        event ageable_grow_up
        event become_cleric {
            add cleric
            add adult
            add behavior_non_peasant
            remove baby
        }
        event entity_born
        event entity_spawned
        event entity_transformed
        event spawn_armorer {
            randomize {
                option weight=6
                option weight=6
                option weight=6
            }
        }
        event spawn_butcher {
            randomize {
                option weight=10
                option weight=10
            }
        }
        event spawn_cleric {
            add cleric
            add adult
            add behavior_non_peasant
            remove baby
        }
        event spawn_farmer {
            randomize {
                option weight=5
                option weight=5
                option weight=5
                option weight=5
            }
        }
        event spawn_librarian {
            randomize {
                option weight=20
                option weight=20
            }
        }
        event start_celebrating {
            add minecraft:celebrate
        }
        event stop_celebrating {
            remove minecraft:celebrate
        }
    }
}
