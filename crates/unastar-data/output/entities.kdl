entity minecraft:copper_golem {
    is_spawnable #true
    is_summonable #true
    properties {
        chest_interaction type=enum client_sync=#true {
            value none
            value take
            value take_fail
            value put
            value put_fail
            default none
        }
        has_flower type=bool default=#false client_sync=#true
        is_becoming_statue type=bool default=#false client_sync=#false
        is_waxed type=bool default=#false client_sync=#false
        oxidation_level type=enum client_sync=#true {
            value unoxidized
            value exposed
            value weathered
            value oxidized
            default unoxidized
        }
    }
    components {
        annotation.open_door
        attack damage=2
        balloonable
        behavior.look_at_player look_distance=6.0 priority=6 probability=0.02
        behavior.panic priority=2 speed_multiplier=1.5
        behavior.random_look_around priority=7
        behavior.random_stroll priority=5 xz_dist=3
        behavior.take_flower {
            filters {
                filter test=is_daytime value=#true
                filter test=bool_property domain=minecraft:has_flower value=#false
            }
            on_take_flower {
                event minecraft:on_take_flower
            }
            priority 4
        }
        behavior.transport_items {
            allow_simultaneous_interaction #false
            destination_container_type minecraft:chest
            destination_container_type minecraft:trapped_chest
            idle_cooldown 7
            initial_cooldown 3
            interaction_time 3.0
            max_stack_size 16
            max_visited_containers 10
            place_strategy with_matching_or_empty
            priority 3
            behavior.transport_item 32
            behavior.transport_item 8
            search_strategy nearest
            source_container_type minecraft:copper_chest
            source_container_type minecraft:exposed_copper_chest
            source_container_type minecraft:oxidized_copper_chest
            source_container_type minecraft:waxed_copper_chest
            source_container_type minecraft:waxed_exposed_copper_chest
            source_container_type minecraft:waxed_oxidized_copper_chest
            source_container_type minecraft:waxed_weathered_copper_chest
            source_container_type minecraft:weathered_copper_chest
        }
        can_climb
        collision_box height=0.98 width=0.6
        conditional_bandwidth_optimization
        damage_sensor {
            trigger cause=fall deals_damage=no
            trigger {
                deals_damage no
                on_damage {
                    event minecraft:remove_oxidation_layer
                    filters {
                        filter test=is_family subject=other value=lightning
                        filter test=is_variant subject=self operator="==" value=0
                    }
                }
            }
        }
        equipment {
            entry drop_chance=1.0 slot=slot.weapon.mainhand
        }
        health 12 max=12
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        interact {
            interaction {
                interact_text action.interact.wax_on
                on_interact {
                    event minecraft:wax_on
                    filters {
                        filter test=bool_property domain=minecraft:is_waxed value=#false
                        filter test=is_family subject=other value=player
                        filter test=has_equipment subject=other domain=hand value=honeycomb
                    }
                }
                particle_on_start {
                    copper_event wax_on
                }
                swing #true
                use_item #true
            }
            interaction {
                hurt_item 1
                interact_text action.interact.scrape
                on_interact {
                    event minecraft:remove_oxidation_layer
                    filters {
                        filter test=bool_property domain=minecraft:is_waxed value=#false
                        filter test=enum_property operator=not domain=minecraft:oxidation_level value=unoxidized
                        filter test=is_family subject=other value=player
                        filter test=has_equipment_tag subject=other domain=hand value=minecraft:is_axe
                    }
                }
                particle_on_start {
                    copper_event scrape
                }
                swing #true
            }
            interaction {
                hurt_item 1
                interact_text action.interact.wax_off
                on_interact {
                    event minecraft:wax_off
                    filters {
                        filter test=bool_property domain=minecraft:is_waxed value=#true
                        filter test=is_family subject=other value=player
                        filter test=has_equipment_tag subject=other domain=hand value=minecraft:is_axe
                    }
                }
                particle_on_start {
                    copper_event wax_off
                }
                swing #true
            }
            interaction {
                drop_item_slot slot.weapon.mainhand
                interact_text action.interact.drop_item
                on_interact {
                    filters {
                        filter test=all_slots_empty operator=not value=hand
                        filter test=is_family subject=other value=player
                        filter test=all_slots_empty subject=other value=main_hand
                    }
                }
                swing #true
            }
            interaction {
                cooldown 2.5
                hurt_item 1
                interact_text action.interact.shear
                on_interact {
                    event minecraft:on_sheared
                    filters {
                        filter test=bool_property domain=minecraft:has_flower value=#true
                        filter test=is_family subject=other value=player
                        filter test=has_equipment subject=other domain=hand value=shears
                    }
                    target self
                }
                play_sounds shear
                spawn_items {
                    table "loot_tables/entities/copper_golem_shear.json"
                }
                use_item #false
                vibration shear
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable
        leashable_to
        loot table="loot_tables/entities/copper_golem.json"
        movement 0.2
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_open_doors=#true can_pass_doors=#true
        persistent
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family copper_golem
            family mob
        }
    }
    component_groups {
        group became_statue {
            instant_despawn
            spawn_entity {
                entities {
                    filters test=bool_property domain=minecraft:has_flower value=#true
                    max_wait_time 0
                    min_wait_time 0
                    spawn_item poppy
                }
            }
        }
        group becoming_statue {
            behavior.place_block {
                affected_by_griefing_rule #false
                can_place {
                    domain minecraft:is_becoming_statue
                    test bool_property
                    value #false
                }
                chance 0.0058
                on_place {
                    event minecraft:become_statue
                    target self
                }
                priority 1
                randomly_placeable_block {
                    block {
                        name minecraft:oxidized_copper_golem_statue
                        states {
                            minecraft:cardinal_direction north
                        }
                    }
                    filter {
                        any_of {
                            filter {
                                filter test=y_rotation operator=">=" value=135
                                filter test=y_rotation operator=< value=180
                            }
                            filter {
                                filter test=y_rotation operator=">=" value=-180
                                filter test=y_rotation operator=< value=-135
                            }
                        }
                    }
                }
                randomly_placeable_block {
                    block {
                        name minecraft:oxidized_copper_golem_statue
                        states {
                            minecraft:cardinal_direction east
                        }
                    }
                    filter {
                        filter test=y_rotation operator=">=" value=-135
                        filter test=y_rotation operator=< value=-45
                    }
                }
                randomly_placeable_block {
                    block {
                        name minecraft:oxidized_copper_golem_statue
                        states {
                            minecraft:cardinal_direction south
                        }
                    }
                    filter {
                        filter test=y_rotation operator=">=" value=-45
                        filter test=y_rotation operator=< value=45
                    }
                }
                randomly_placeable_block {
                    block {
                        name minecraft:oxidized_copper_golem_statue
                        states {
                            minecraft:cardinal_direction west
                        }
                    }
                    filter {
                        filter test=y_rotation operator=">=" value=45
                        filter test=y_rotation operator=< value=135
                    }
                }
                xz_range 0
                y_range 0
            }
        }
        group copper_oxidizing {
            timer {
                looping #true
                entry 25200
                entry 27600
                time_down_event {
                    event minecraft:oxidize_copper
                }
            }
        }
    }
    events {
        event become_statue {
            trigger minecraft:serialize_entity
        }
        event begin_oxidizing {
            add minecraft:copper_oxidizing
        }
        event entity_spawned {
            trigger minecraft:begin_oxidizing
        }
        event from_player_default {
            trigger minecraft:from_player_spawned
        }
        event from_player_exposed {
            trigger minecraft:from_player_spawned
        }
        event from_player_oxidized {
            trigger minecraft:maximum_oxidation
        }
        event from_player_spawned {
            trigger minecraft:begin_oxidizing
        }
        event from_player_weathered {
            trigger minecraft:from_player_spawned
        }
        event from_serialized_entity {
            trigger minecraft:restart_oxidation_timer
        }
        event maximum_oxidation {
            add minecraft:becoming_statue
            remove minecraft:copper_oxidizing
        }
        event on_sheared
        event on_take_flower
        event oxidize_copper
        event remove_oxidation_layer
        event restart_oxidation_timer {
            add minecraft:copper_oxidizing
            remove minecraft:copper_oxidizing
            remove minecraft:becoming_statue
        }
        event serialize_entity_succeeded {
            add minecraft:became_statue
            trigger minecraft:randomize_pose
        }
        event transport_items.start_place_fail
        event transport_items.start_place_succeed
        event transport_items.start_take_fail
        event transport_items.start_take_succeed
        event transport_items.stop_interaction
        event wax_off
        event wax_on {
            remove minecraft:copper_oxidizing
            remove minecraft:becoming_statue
        }
    }
}
