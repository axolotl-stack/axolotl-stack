                    event minecraft:melee_mode
                    filters test=has_ranged_weapon value=#false
                }
                trigger {
                    event got_in_powder_snow
                    filters test=in_block subject=self value=minecraft:powder_snow
                }
            }
            shooter def=minecraft:arrow sound=bow
        }
    }
    events {
        event become_stray_event {
            add become_stray
        }
        event got_in_powder_snow {
            add in_powder_snow
        }
        event got_out_of_powder_snow {
            add got_out_of_powder_snow_environment_sensor
            remove in_powder_snow
        }
        event entity_spawned {
            add minecraft:ranged_attack
        }
        event melee_mode {
            add minecraft:melee_attack
            remove minecraft:ranged_attack
            remove got_out_of_powder_snow_environment_sensor
        }
        event ranged_mode {
            add minecraft:ranged_attack
            remove minecraft:melee_attack
            remove got_out_of_powder_snow_environment_sensor
        }
        event spring_trap {
            add minecraft:lightning_immune
        }
    }
}
