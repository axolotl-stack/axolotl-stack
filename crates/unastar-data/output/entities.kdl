        behavior.random_stroll priority=6 speed_multiplier=0.7
        behavior.tempt {
            item red_mushroom
            priority 3
            speed_multiplier 1.2
        }
        breathable breathes_water=#true suffocate_time=0 total_supply=15
        burns_in_daylight protection_slot=slot.armor.body
        collision_box height=1.6 width=1.4
        conditional_bandwidth_optimization
        despawn {
            despawn_from_distance
        }
        environment_sensor {
            trigger {
                event minecraft:upgrade_to_1_21_130
                filters test=bool_property operator="!=" domain=minecraft:was_upgraded_to_1_21_130
            }
        }
        equippable {
            slot {
                accepted_item saddle
                item saddle
                on_equip {
                    event minecraft:horse_saddled
                }
                on_unequip {
                    event minecraft:horse_unsaddled
                }
                slot 0
            }
            slot {
                accepted_item horsearmorleather
                accepted_item horsearmoriron
                accepted_item horsearmorgold
                accepted_item horsearmordiamond
                accepted_item minecraft:copper_horse_armor
                accepted_item minecraft:netherite_horse_armor
                item horsearmoriron
                slot 1
            }
        }
        healable {
            item heal_amount=3 item=red_mushroom
        }
        health 25 max=25
        horse.jump_strength {
            value {
                range_max 0.7
                range_min 0.5
            }
        }
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava
            }
        }
        is_hidden_when_invisible
        jump.static
        movement {
            value {
                range_max 0.275
                range_min 0.205
            }
        }
        movement.basic
        nameable
        navigation.walk {
            avoid_damage_blocks #true
            avoid_sun #true
            avoid_water #true
            entry minecraft:rail
            entry minecraft:activator_rail
            entry minecraft:detector_rail
            entry minecraft:golden_rail
            is_amphibious #true
        }
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family zombiehorse
            family undead
            family mob
        }
    }
    component_groups {
        group horse_adult {
            behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
            behavior.run_around_like_crazy priority=1 speed_multiplier=1.2
            experience_reward on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/zombie_horse.json"
        }
        group horse_baby {
            ageable {
                duration 1200
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=4 speed_multiplier=1.0
            is_baby
            scale_by_age end_scale=0.5 start_scale=0.5
        }
        group horse_can_be_leashed {
            environment_sensor {
                trigger {
                    event minecraft:hostile_mounted
                    filters test=is_controlling_passenger_family subject=self value=zombie
                }
            }
            leashable {
                on_unleash {
                    event minecraft:on_unleashed
                    target self
                }
                preset {
                    filter test=is_family subject=other value=happy_ghast
                    spring_type quad_dampened
                }
                preset hard_distance=10 max_distance=14
            }
        }
        group horse_saddled {
            behavior.player_ride_tamed
            can_power_jump
            input_ground_controlled
            is_saddled
        }
        group horse_tamed {
            interact {
                interaction {
                    equip_item_slot "1"
                    interact_text action.interact.equiphorsearmor
                    on_interact {
                        filters {
                            filter test=has_equipment_tag operator=not domain=inventory value=minecraft:horse_armor
                            filter test=has_equipment_tag subject=player domain=hand value=minecraft:horse_armor
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "1"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removehorsearmor
                    on_interact {
                        filters {
                            filter test=rider_count value=0
                            filter test=has_equipment_tag domain=inventory value=minecraft:horse_armor
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds armor.unequip_generic
                    vibration shear
                }
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds saddle
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count value=0
                            filter test=has_equipment domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            inventory container_type=horse inventory_size=2
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.1
                    seat -0.2
                }
            }
        }
        group horse_wild {
            behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
            rideable {
                family_type player
                family_type zombie_rider
                family_type baby_zombie
                family_type baby_husk
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.1
                    seat -0.2
                }
            }
            tamemount {
                auto_reject_item item=horsearmorleather
                auto_reject_item item=horsearmoriron
                auto_reject_item item=horsearmorgold
                auto_reject_item item=horsearmordiamond
                auto_reject_item item=minecraft:copper_horse_armor
                auto_reject_item item=minecraft:netherite_horse_armor
                auto_reject_item item=saddle
                feed_item item=red_mushroom temper_mod=10
                feed_text action.interact.feed
                max_temper 100
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
        group horse_wild_with_rider {
            addrider {
                rider entity_type=minecraft:zombie spawn_event=minecraft:spawn_as_rider
            }
            environment_sensor {
                trigger {
                    event minecraft:hostile_dismounted
                    filters test=rider_count subject=self value=0
                }
            }
        }
    }
    events {
        event entity_born {
            add minecraft:horse_baby
        }
        event entity_spawned {
            randomize {
                option weight=36 trigger=minecraft:spawn_adult
                option weight=9 trigger=minecraft:entity_born
            }
        }
        event horse_saddled {
            add minecraft:horse_saddled
        }
        event horse_unsaddled {
            remove minecraft:horse_saddled
        }
        event hostile_dismounted {
            add minecraft:horse_can_be_leashed
            remove minecraft:horse_wild_with_rider
        }
        event hostile_mounted {
            add minecraft:horse_wild_with_rider
            remove minecraft:horse_can_be_leashed
        }
        event on_tame {
            add minecraft:horse_tamed
            remove minecraft:horse_wild
        }
        event spawn_adult {
            add minecraft:horse_adult
            add minecraft:horse_wild
            add minecraft:horse_can_be_leashed
        }
        event spawn_adult_with_rider {
            add minecraft:horse_adult
            add minecraft:horse_wild
            add minecraft:horse_wild_with_rider
            remove minecraft:horse_baby
            remove minecraft:horse_can_be_leashed
        }
        event spawn_tame_adult {
            add minecraft:horse_adult
            add minecraft:horse_tamed
            add minecraft:horse_can_be_leashed
        }
        event upgrade_to_1_21_130
    }
}
