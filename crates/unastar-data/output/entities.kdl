            remove minecraft:adult_harnessed
        }
        event on_unleashed
        event spawn_adult {
            add minecraft:adult
            add minecraft:adult_mobile
            add minecraft:adult_unharnessed
            add minecraft:adult_without_passengers
        }
        event spawn_baby {
            add minecraft:baby
        }
