entity minecraft:strider {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    components {
        balloonable
        behavior.look_at_player look_distance=6.0 priority=9 probability=0.02
        behavior.panic {
            panic_sound panic
            priority 3
            sound_interval {
                range_max 3.0
                range_min 1.0
            }
            speed_multiplier 1.1
        }
        behavior.random_look_around priority=10
        behavior.tempt {
            can_tempt_while_ridden #true
            item warped_fungus
            item warped_fungus_on_a_stick
            priority 5
            sound_interval {
                range_max 5.0
                range_min 2.0
            }
            speed_multiplier 1.2
            tempt_sound tempt
        }
        collision_box height=1.7 width=0.9
        conditional_bandwidth_optimization
        despawn {
            despawn_from_distance
        }
        fire_immune
        health 20 max=20
        hurt_on_condition {
            condition {
                cause drowning
                damage_per_tick 1
                filters test=in_contact_with_water
            }
        }
        is_hidden_when_invisible
        jump.static
        lava_movement 0.32
        leashable
        movement 0.16
        movement.basic
        movement_sound_distance_offset 0.6
        nameable
        navigation.walk avoid_water=#true can_path_over_lava=#true can_sink=#false can_walk_in_lava=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family strider
            family mob
        }
    }
    component_groups {
        group detect_suffocating {
            environment_sensor {
                trigger {
                    event start_suffocating
                    filters {
                        filter test=in_lava subject=self operator="==" value=#false
                        filter {
                            any_of {
                                filter test=is_riding subject=self operator="==" value=#false
                                filter test=in_lava subject=other operator="==" value=#false
                            }
                        }
                    }
                }
                trigger {
                    event on_not_riding_parent
                    filters {
                        filter test=is_riding subject=self operator=equals value=#false
                        filter test=has_component subject=self operator=not value=minecraft:behavior.move_to_liquid
                    }
                }
            }
        }
        group start_suffocating {
            environment_sensor {
                trigger {
                    event stop_suffocating
                    filters {
                        any_of {
                            filter test=in_lava subject=self operator="==" value=#true
                            filter test=in_lava subject=other operator="==" value=#true
                        }
                    }
                }
                trigger {
                    event on_not_riding_parent
                    filters {
                        filter test=is_riding subject=self operator=equals value=#false
                        filter test=has_component subject=self operator=not value=minecraft:behavior.move_to_liquid
                    }
                }
            }
            is_shaking
        }
        group strider_adult {
            behavior.breed priority=4 speed_multiplier=1.0
            breedable {
                breed_item warped_fungus
                breeds_with {
                    baby_type minecraft:strider
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:strider
                }
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
            loot table="loot_tables/entities/strider.json"
            type_family {
                family strider
                family strider_adult
                family mob
            }
        }
        group strider_baby {
            ageable {
                duration 1200
                feed_item warped_fungus
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=6 speed_multiplier=1.1
            is_baby
            scale 0.5
            type_family {
                family strider
                family strider_baby
                family mob
            }
        }
        group strider_parent_jockey {
            addrider entity_type=minecraft:strider spawn_event=minecraft:spawn_baby_strider_jockey
            rideable {
                family_type strider
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.7
                    seat 0.0
                }
            }
        }
        group strider_pathing_behaviors {
            behavior.move_to_liquid goal_radius=0.9 material_type=Lava priority=7 search_count=30 search_height=10 search_range=16
            behavior.random_stroll priority=8 speed_multiplier=0.8
            behavior.rise_to_liquid_level liquid_y_offset=0.25 priority=0 rise_delta=0.01 sink_delta=0.01
        }
        group strider_piglin_jockey {
            addrider entity_type=minecraft:zombie_pigman spawn_event=minecraft:spawn_as_strider_jockey
            rideable {
                crouching_skip_interact #true
                family_type player
                family_type zombie_pigman
                interact_text action.interact.ride.strider
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.7
                    seat -0.2
                }
            }
        }
        group strider_saddled {
            behavior.controlled_by_player mount_speed_multiplier=1.45 priority=0
            boostable {
                boost_item damage=1 item=warped_fungus_on_a_stick replace_item=fishing_rod
                duration 16.0
                speed_multiplier 1.35
            }
            interact {
                interaction {
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        event minecraft:on_unsaddled
                        filters {
                            filter test=is_sneak_held subject=other value=#false
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=rider_count subject=self operator=equals value=0
                        }
                    }
                    play_sounds unsaddle
                    spawn_items {
                        table "loot_tables/entities/saddle.json"
                        y_offset 1.7
                    }
                    vibration shear
                }
            }
            is_saddled
            item_controllable control_items=warped_fungus_on_a_stick
            loot table="loot_tables/entities/strider_saddled.json"
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.strider
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.7
                    seat -0.2
                }
            }
        }
        group strider_unsaddled {
            interact {
                interaction {
                    interact_text action.interact.saddle
                    on_interact {
                        event minecraft:on_saddled
                        filters test=has_equipment subject=other domain=hand value=saddle
                    }
                    play_sounds saddle
                    use_item #true
                }
            }
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:strider_adult
            add minecraft:strider_unsaddled
            remove minecraft:strider_baby
        }
        event entity_born {
            trigger spawn_baby
        }
        event entity_spawned {
            randomize {
                option weight=40 trigger=spawn_adult
                option weight=2 trigger=spawn_adult_piglin_jockey
                option weight=8 trigger=spawn_adult_parent_jockey
                option weight=50 trigger=spawn_baby
            }
        }
        event on_saddled {
            add minecraft:strider_saddled
            remove minecraft:strider_unsaddled
        }
        event on_unsaddled {
            add minecraft:strider_unsaddled
            remove minecraft:strider_saddled
        }
        event spawn_baby_strider_jockey {
            add minecraft:strider_baby
            add minecraft:detect_suffocating
        }
        event on_not_riding_parent {
            add minecraft:strider_pathing_behaviors
        }
        event spawn_adult {
            add minecraft:strider_adult
            add minecraft:strider_unsaddled
            add minecraft:detect_suffocating
            add minecraft:strider_pathing_behaviors
        }
        event spawn_adult_parent_jockey {
            add minecraft:strider_adult
            add minecraft:strider_parent_jockey
            add minecraft:strider_unsaddled
            add minecraft:detect_suffocating
            add minecraft:strider_pathing_behaviors
        }
        event spawn_adult_piglin_jockey {
            add minecraft:strider_adult
            add minecraft:strider_saddled
            add minecraft:strider_piglin_jockey
            add minecraft:detect_suffocating
            add minecraft:strider_pathing_behaviors
        }
        event spawn_baby {
            add minecraft:strider_baby
            add minecraft:detect_suffocating
            add minecraft:strider_pathing_behaviors
        }
        event start_suffocating {
            add minecraft:start_suffocating
        }
        event stop_suffocating {
            add minecraft:detect_suffocating
            remove minecraft:start_suffocating
        }
    }
}
