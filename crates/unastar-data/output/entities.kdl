                        event minecraft:panda_aggressive
                        target self
                    }
                    main_allele 3
                }
                genetic_variant {
                    birth_event {
                        event minecraft:panda_weak
                        target self
                    }
                    both_allele {
                        range_max 7
                        range_min 4
                    }
                }
                genetic_variant {
                    birth_event {
                        event minecraft:panda_brown
                        target self
                    }
                    both_allele {
                        range_max 9
                        range_min 8
                    }
                }
                name panda_variant
            }
            mutation_rate 0.03125
        }
        giveable {
            triggers {
                cooldown 3.0
                item bamboo
                item cake
                on_give {
                    event minecraft:on_calm
                    target self
                }
            }
        }
        health 20 max=20
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        inventory inventory_size=1 private=#true
        is_hidden_when_invisible
        jump.static
        movement 0.15
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_float=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        rideable {
            family_type baby_zombie
            family_type baby_husk
            seat_count 1
            seats {
                seat 0.0
                seat 1.085
                seat 0.0
            }
        }
        scale 1.0
        type_family {
            family panda
        }
        variant 0
        water_movement drag_factor=0.98
    }
    component_groups {
        group baby_scared {
            angry {
                broadcast_anger #true
                broadcast_filters {
                    operator "=="
                    test is_family
                    value panda_aggressive
                }
                broadcast_range 41
                calm_event {
                    event minecraft:baby_on_calm
                    target self
                }
                duration 1
            }
        }
        group panda_adult {
            attack damage=2.0
            behavior.breed priority=3 speed_multiplier=1.0
            behavior.melee_box_attack attack_once=#true priority=2 track_target=#true
            breedable {
                blend_attributes #false
                breed_items bamboo
                breeds_with {
                    baby_type minecraft:panda
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:panda
                }
                environment_requirements {
                    blocks bamboo
                    count 8
                    radius 5
                }
                mutation_factor {
                    variant 1.0
                }
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            loot table="loot_tables/entities/panda.json"
            on_target_acquired event=minecraft:become_angry target=self
            on_target_escape event=minecraft:on_calm target=self
        }
        group panda_aggressive {
            attack damage=6.0
            behavior.melee_box_attack priority=2 track_target=#true
            behavior.panic {
                damage_source campfire
                damage_source fire
                damage_source fire_tick
                damage_source freezing
                damage_source lightning
                damage_source lava
                damage_source magma
                damage_source temperature
                damage_source soul_campfire
                ignore_mob_damage #true
                priority 1
                speed_multiplier 1.25
            }
            on_friendly_anger event=minecraft:on_anger target=self
            type_family {
                family panda
                family panda_aggressive
                family mob
            }
            variant 6
        }
        group panda_angry {
            angry {
                broadcast_anger #true
                broadcast_filters {
                    operator "=="
                    test is_family
                    value panda_aggressive
                }
                broadcast_range 41
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 500
            }
            on_target_acquired
        }
        group panda_baby {
            ageable {
                duration 1200
                feed_items bamboo
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=13 speed_multiplier=1.1
            behavior.roll priority=12 probability=0.0016
            behavior.sneeze {
                cooldown_time 1.0
                drop_item_chance 0.001
                entity_type {
                    filters {
                        filter test=has_component subject=other operator="!=" value=minecraft:is_baby
                        filter test=is_family subject=other value=panda
                        filter test=in_water subject=other operator="!=" value=#true
                        filter test=on_ground operator="==" value=#true
                    }
                    max_dist 10
                }
                loot_table "loot_tables/entities/panda_sneeze.json"
                prepare_sound presneeze
                prepare_time 1.0
                priority 7
                probability 0.0001666
                sound sneeze
                within_radius 10.0
            }
            is_baby
            on_target_acquired event=minecraft:on_scared target=self
            scale 0.4
        }
        group panda_brown {
            variant 4
        }
        group panda_lazy {
            behavior.lay_down interval=400 priority=5 random_stop_interval=2000
            behavior.panic priority=1 speed_multiplier=2.5
            behavior.random_sitting cooldown=25 min_sit_time=15 priority=6 start_chance=0.02 stop_chance=0.2
            behavior.snacking {
                item bamboo
                item cake
                priority 3
                snacking_cooldown 17.5
                snacking_cooldown_min 10
                snacking_stop_chance 0.0011
            }
            movement 0.07
            variant 1
        }
        group panda_playful {
            behavior.roll priority=12 probability=0.013
            variant 3
        }
        group panda_sneezing {
            behavior.sneeze {
                cooldown_time 1.0
                drop_item_chance 0.001
                entity_type {
                    filters {
                        filter test=has_component subject=other operator="!=" value=minecraft:is_baby
                        filter test=is_family subject=other value=panda
                        filter test=in_water subject=other operator="!=" value=#true
                        filter test=on_ground operator="==" value=#true
                    }
                    max_dist 10
                }
                loot_table "loot_tables/entities/panda_sneeze.json"
                prepare_sound presneeze
                prepare_time 1.0
                priority 7
                probability 0.002
                sound sneeze
                within_radius 10.0
            }
        }
        group panda_weak {
            health 10 max=10
            variant 5
        }
        group panda_worried {
            behavior.avoid_mob_type {
                entity_type {
                    filters test=is_family subject=other operator="!=" value=panda
                    max_dist 16
                    sprint_speed_multiplier 1.5
                }
                max_dist 16
                max_flee 20
                priority 5
            }
            behavior.scared priority=1 sound_interval=20
            variant 2
        }
    }
    events {
        event ageable_grow_up
        event baby_on_calm {
            remove minecraft:baby_scared
        }
        event become_angry {
            add minecraft:panda_angry
        }
        event entity_born {
            add minecraft:panda_baby
        }
        event entity_spawned {
            randomize {
                option weight=95
                option weight=5
            }
        }
        event on_calm {
            remove minecraft:panda_angry
        }
        event on_scared {
            add minecraft:baby_scared
        }
        event panda_aggressive {
            add minecraft:panda_aggressive
        }
        event panda_brown {
            add minecraft:panda_brown
        }
        event panda_lazy {
            add minecraft:panda_lazy
        }
        event panda_playful {
            add minecraft:panda_playful
        }
        event panda_weak
        event panda_worried {
            add minecraft:panda_worried
        }
    }
}
