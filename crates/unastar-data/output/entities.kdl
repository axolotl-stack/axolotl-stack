        group add_raid_omen {
            spell_effects {
                add_effect display_on_screen_animation=#true duration=30 effect=raid_omen
                remove_effects bad_omen
            }
            timer {
                looping #false
                entry 0.0
                entry 0.0
                time_down_event {
                    event minecraft:clear_add_raid_omen
                    target self
                }
            }
        }
        group clear_raid_omen_spell_effect {
            spell_effects
        }
        group raid_trigger {
            raid_trigger {
                triggered_event {
                    event minecraft:remove_raid_trigger
                    target self
                }
            }
        }
    }
    events {
        event clear_add_raid_omen {
            add minecraft:clear_raid_omen_spell_effect
            remove minecraft:add_raid_omen
        }
        event gain_raid_omen {
            add minecraft:add_raid_omen
        }
        event remove_raid_trigger {
            remove minecraft:raid_trigger
        }
        event trigger_raid {
            add minecraft:raid_trigger
        }
    }
}
