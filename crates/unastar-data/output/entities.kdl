                duration 1200
                feed_item crimson_fungus
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            attack damage=1.0
            behavior.follow_parent priority=6 speed_multiplier=1
            behavior.melee_box_attack cooldown_time=0.75 priority=4 speed_multiplier=1 track_target=#true
            behavior.panic priority=1 speed_multiplier=1
            collision_box height=0.85 width=0.85
            custom_hit_test {
                hitboxe {
                    height 0.85
                    entry 0
                    entry 0.5
                    entry 0
                    width 1.0
                }
            }
            is_baby
            movement 0.36
            rideable {
                family_type piglin
                seat_count 3
                seat {
                    lock_rider_rotation 0
                    entry 0.0
                    entry 1.125
                    entry -0.3
                }
                seat {
                    lock_rider_rotation 0
                    entry 0.0
                    entry 2.625
                    entry -0.3
                }
                seat {
                    lock_rider_rotation 0
                    entry 0.0
                    entry 4.125
                    entry -0.3
                }
            }
            scale 0.5
            type_family {
                family hoglin
                family hoglin_baby
                family mob
            }
        }
        group start_zombification {
            environment_sensor {
                triggers {
                    event stop_zombification_event
                    filters test=in_nether subject=self operator="==" value=#true
                }
            }
            is_shaking
            timer {
                looping #false
                time 15
                time_down_event {
                    event become_zombie_event
                }
            }
        }
        group unhuntable_adult {
            type_family {
                family hoglin
                family hoglin_adult
                family mob
            }
        }
        group zombification_sensor {
            environment_sensor {
                triggers {
                    event start_zombification_event
                    filters test=in_nether subject=self operator="==" value=#false
                }
            }
        }
    }
    events {
        event attack_cooldown_complete_event {
            remove attack_cooldown
        }
        event become_angry_event {
            add angry_hoglin
        }
        event become_calm_event {
            remove angry_hoglin
        }
        event become_zombie_event {
            add become_zombie
        }
        event escaped_event {
            add attack_cooldown
            remove angry_hoglin
        }
        event ageable_grow_up {
            add minecraft:hoglin_adult
            add huntable_adult
            remove minecraft:hoglin_baby
        }
        event entity_born {
            trigger spawn_baby
        }
        event entity_spawned {
            randomize {
                option weight=95 trigger=spawn_adult
                option weight=5 trigger=spawn_baby
            }
        }
        event spawn_adult {
            add minecraft:hoglin_adult
            add huntable_adult
            add zombification_sensor
        }
        event spawn_adult_unhuntable {
            add minecraft:hoglin_adult
            add unhuntable_adult
            add zombification_sensor
        }
        event spawn_baby {
            add minecraft:hoglin_baby
            add zombification_sensor
        }
        event start_zombification_event {
            add start_zombification
            remove zombification_sensor
        }
        event stop_zombification_event {
            add zombification_sensor
            remove start_zombification
        }
    }
}
