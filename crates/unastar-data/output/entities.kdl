                interaction {
                    admire #true
                    barter #true
                    cooldown_after_being_attacked 20
                    interact_text action.interact.barter
                    on_interact {
                        filters {
                            filter test=has_equipment subject=other domain=hand value=gold_ingot
                            filter test=is_family subject=other value=player
                            filter test=has_component subject=self operator="!=" value=minecraft:is_baby
                        }
                    }
                    use_item #true
                }
            }
        }
