            despawn_from_distance
        }
        environment_sensor {
            trigger {
                event minecraft:all_riders_dismounted
                filters {
                    filter test=bool_property domain=minecraft:has_rider_mounted
                    filter test=rider_count subject=self value=0
                }
            }
            trigger {
                event minecraft:rider_mounted
                filters {
                    filter test=bool_property domain=minecraft:has_rider_mounted value=#false
                    filter test=rider_count subject=self operator=> value=0
                }
            }
        }
        experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
        healable {
            item heal_amount=2 item=rabbit_foot
        }
        health 32
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self
            }
        }
        inventory container_type=horse
        is_hidden_when_invisible
        is_tamed
        jump.static
        loot table="loot_tables/entities/camel_husk.json"
        movement 0.09
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true can_path_over_water=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        rideable {
            crouching_skip_interact #true
            family_type player
            family_type parched
            family_type husk_rider
            interact_text action.interact.ride.horse
            seat_count 2
            seat {
                max_rider_count 2
                min_rider_count 0
                entry 0.0
                entry 1.905
                entry 0.5
            }
            seat {
                max_rider_count 2
                min_rider_count 1
                entry 0.0
                entry 1.905
                entry -0.5
            }
        }
        type_family {
            family camel_husk
            family mob
            family undead
        }
        variable_max_auto_step base_value=1.5625 controlled_value=1.5625 jump_prevented_value=0.5625
    }
    component_groups {
        group camel_husk_saddled {
            behavior.player_ride_tamed priority=1
            dash_action cooldown_time=2.75 horizontal_momentum=20.0 vertical_momentum=0.6
            input_ground_controlled
            is_saddled
        }
        group camel_husk_sitting {
            collision_box height=0.945 width=1.7
            pushable is_pushable=#false is_pushable_by_piston=#true
        }
        group camel_husk_standing {
            collision_box height=2.375 width=1.7
            pushable is_pushable=#true is_pushable_by_piston=#true
        }
        group camel_husk_with_hostile_rider {
            addrider {
                rider entity_type=minecraft:husk spawn_event=minecraft:spawn_as_rider
                rider entity_type=minecraft:parched spawn_event=minecraft:ranged_mode
            }
        }
        group camel_husk_with_no_hostile_rider {
            behavior.tempt {
                can_tempt_vertically #true
                item rabbit_foot
                priority 4
                speed_multiplier 2.5
            }
            equippable {
                slot {
                    accepted_item saddle
                    item saddle
                    on_equip {
                        event minecraft:camel_husk_saddled
                    }
                    on_unequip {
                        event minecraft:camel_husk_unsaddled
                    }
                    slot 0
                }
            }
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds saddle
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 2
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=is_sitting subject=self value=#false
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=is_sitting subject=self
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            leashable {
                preset {
                    filter test=is_family subject=other value=happy_ghast
                    spring_type quad_dampened
                }
            }
            leashable_to
        }
        group camel_husk_with_no_rider {
            behavior.panic priority=2 speed_multiplier=4
        }
    }
    events {
        event all_riders_dismounted {
            add minecraft:camel_husk_with_no_rider
            add minecraft:camel_husk_with_no_hostile_rider
            remove minecraft:camel_husk_with_hostile_rider
        }
        event camel_husk_saddled {
            add minecraft:camel_husk_saddled
        }
        event camel_husk_unsaddled {
            remove minecraft:camel_husk_saddled
        }
        event entity_spawned {
            add minecraft:camel_husk_standing
            add minecraft:camel_husk_with_no_rider
            add minecraft:camel_husk_with_no_hostile_rider
        }
        event rider_mounted {
            remove minecraft:camel_husk_with_no_rider
        }
        event spawn_with_rider {
            add minecraft:camel_husk_standing
            add minecraft:camel_husk_with_hostile_rider
            remove minecraft:camel_husk_with_no_rider
            remove minecraft:camel_husk_with_no_hostile_rider
        }
        event start_sitting {
            add minecraft:camel_husk_sitting
            remove minecraft:camel_husk_standing
        }
        event stop_sitting {
            add minecraft:camel_husk_standing
            remove minecraft:camel_husk_sitting
        }
    }
}
