entity minecraft:sniffer {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    components {
        balloonable
        behavior.float priority=0
        behavior.look_at_player priority=8 probability=0.02 target_distance=6.0
        behavior.panic priority=1 speed_multiplier=2
        behavior.random_look_around priority=9
        behavior.random_stroll priority=7 speed_multiplier=1
        behavior.tempt {
            item torchflower_seeds
            priority 4
            speed_multiplier 1.25
        }
        behavior.timer_flag_1 {
            control_flag move
            control_flag look
            entry 400.0
            entry 500.0
            duration_range 2.0
            on_end {
                event on_scenting_success
                target self
            }
            priority 6
        }
        breathable suffocate_time=0 total_supply=15
        can_climb
        collision_box height=1.75 width=1.9
        conditional_bandwidth_optimization
        follow_range 64.0
        healable {
            item heal_amount=2 item=torchflower_seeds
        }
        health 14
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable {
            preset {
                filter test=is_family subject=other value=happy_ghast
                spring_type quad_dampened
            }
        }
        movement 0.09
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_path_over_water=#true
        persistent
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family sniffer
            family mob
        }
    }
    component_groups {
        group feeling_happy {
            behavior.timer_flag_3 {
                cooldown_range 0.0
                entry 2.0
                entry 5.0
                on_end {
                    event on_feeling_happy_end
                    target self
                }
                priority 5
            }
        }
        group pushable {
            pushable is_pushable=#true is_pushable_by_piston=#true
        }
        group sniffer_adult {
            behavior.breed priority=3 speed_multiplier=1.0
            breedable {
                breed_item torchflower_seeds
                entry {
                    breed_event {
                        event on_pregnant
                        target self
                    }
                    mate_type minecraft:sniffer
                }
                causes_pregnancy #true
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
        }
        group sniffer_baby {
            ageable {
                duration 2400
                feed_item torchflower_seeds
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            is_baby
            scale 0.45
        }
        group sniffer_pregnant {
            is_pregnant
            spawn_entity {
                entities {
                    max_wait_time 0
                    min_wait_time 0
                    single_use #true
                    spawn_item sniffer_egg
                    spawn_item_event {
                        event on_egg_spawned
                        target self
                    }
                    spawn_sound plop
                }
            }
        }
        group sniffer_search_and_dig {
            behavior.random_search_and_dig {
                cooldown_range 0.0
                entry 8.0
                entry 10.0
                find_valid_position_retries 5
                goal_radius 2.0
                item_table "loot_tables/gameplay/entities/sniffer_seeds.json"
                on_digging_start {
                    event on_digging_start
                    target self
                }
                on_fail_during_digging {
                    event on_fail_during_digging
                    target self
                }
                on_fail_during_searching {
                    event on_fail_during_searching
                    target self
                }
                on_item_found {
                    event on_item_found
                    target self
                }
                on_searching_start {
                    event on_searching_start
                    target self
                }
                on_success {
                    event on_search_and_digging_success
                    target self
                }
                priority 5
                search_range_xz 20.0
                search_range_y 3
                spawn_item_after_seconds 6.0
                spawn_item_pos_offset 2.25
                speed_multiplier 1.25
                target_block minecraft:dirt
                target_block minecraft:coarse_dirt
                target_block minecraft:grass
                target_block minecraft:podzol
                target_block minecraft:dirt_with_roots
                target_block minecraft:moss_block
                target_block minecraft:pale_moss_block
                target_block minecraft:mud
                target_block minecraft:muddy_mangrove_roots
            }
        }
        group stand_up {
            behavior.timer_flag_2 {
                control_flag move
                cooldown_range 0.0
                entry 2.0
                entry 5.0
                on_end {
                    event on_rising_end
                    target self
                }
                priority 2
            }
        }
    }
    events {
        event ageable_grow_up {
            add sniffer_adult
            remove sniffer_baby
        }
        event entity_born {
            add sniffer_baby
            add pushable
        }
        event entity_spawned {
            randomize {
                option weight=95 trigger=minecraft:spawn_adult
                option weight=5 trigger=minecraft:entity_born
            }
        }
        event spawn_adult {
            add sniffer_adult
            add pushable
        }
        event on_digging_start {
            remove pushable
        }
        event on_egg_spawned {
            remove sniffer_pregnant
        }
        event on_fail_during_digging {
            add pushable
            add stand_up
            remove sniffer_search_and_dig
        }
        event on_fail_during_searching {
            remove sniffer_search_and_dig
        }
        event on_feeling_happy_end {
            remove feeling_happy
        }
        event on_item_found {
            add feeling_happy
        }
        event on_pregnant {
            add sniffer_pregnant
        }
        event on_rising_end {
            remove stand_up
        }
        event on_scenting_success
        event on_search_and_digging_success {
            add pushable
            add stand_up
            remove sniffer_search_and_dig
        }
    }
}
entity minecraft:snow_golem {
