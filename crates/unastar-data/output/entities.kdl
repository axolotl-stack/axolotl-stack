        behavior.hurt_by_target priority=1
        behavior.random_swim interval=0 priority=6 speed_multiplier=1.5 xz_dist=16 y_dist=4
        behavior.swim_idle idle_time=5 priority=8 success_rate=0.1
        behavior.swim_wander interval=10 look_ahead=2.0 priority=7 speed_multiplier=1.5 wander_time=5.0
