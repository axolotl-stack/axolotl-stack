entity minecraft:zoglin {
    spawn_category monster
    is_spawnable #true
    is_summonable #true
    components {
        balloonable
        behavior.look_at_player look_distance=6.0 priority=8 probability=0.02
        behavior.melee_box_attack priority=4 speed_multiplier=1.15 track_target=#true
        behavior.nearest_attackable_target {
            entity_type {
                filters {
                    filter test=is_family subject=other operator="!=" value=zoglin
                    filter test=is_family subject=other operator="!=" value=creeper
                }
                max_dist 16
            }
            must_see #true
            priority 3
            within_radius 16.0
        }
        behavior.random_look_around priority=9
        behavior.random_stroll priority=7 speed_multiplier=1.0
        breathable breathes_water=#true suffocate_time=0 total_supply=15
        can_climb
        collision_box height=1.8 width=0.6
        conditional_bandwidth_optimization
        despawn {
            filters {
                any_of {
                    filter {
                        filter test=is_persistent value=#false
                        filter test=distance_to_nearest_player operator=> value=54
                    }
                    filter {
                        filter test=is_persistent value=#false
                        filter test=inactivity_timer subject=self value=30
                        filter test=random_chance value=800
                        filter test=distance_to_nearest_player operator=> value=32
                    }
                }
            }
        }
        experience_reward on_death="query.last_hit_by_player ? 5 : 0"
        fire_immune
        health 40 max=40
        is_hidden_when_invisible
        jump.static
        knockback_resistance 0.6
        leashable
        loot table="loot_tables/entities/zoglin.json"
        movement 0.25
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_path_over_water=#false is_amphibious=#true
        on_target_acquired event=become_angry_event target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
    }
    component_groups {
        group angry_zoglin {
            angry {
                angry_sound angry
                calm_event {
                    event become_calm_event
                    target self
                }
                duration 10
                sound_interval {
                    range_max 5.0
                    range_min 2.0
                }
            }
        }
        group zoglin_adult {
            attack {
                entry 3
                entry 8
            }
            behavior.hurt_by_target priority=1
            collision_box height=1.4 width=1.4
            custom_hit_test {
                hitboxe {
                    height 1.75
                    entry 0
                    entry 1
                    entry 0
                    width 2.0
                }
            }
            leashable_to
            type_family {
                family zoglin
                family zoglin_adult
                family undead
                family monster
                family mob
            }
        }
        group zoglin_baby {
            attack damage=0.5
            collision_box height=0.85 width=0.85
            custom_hit_test {
                hitboxe {
                    height 0.85
                    entry 0
                    entry 0.5
                    entry 0
                    width 1.0
                }
            }
            is_baby
            scale 0.5
            type_family {
                family zoglin
                family zoglin_baby
                family undead
                family monster
                family mob
            }
        }
    }
    events {
        event become_angry_event {
            add angry_zoglin
        }
        event become_calm_event {
            remove angry_zoglin
        }
        event as_adult {
            add zoglin_adult
        }
        event as_baby {
            add zoglin_baby
        }
        event entity_spawned {
            randomize {
                option weight=95
                option weight=5
            }
        }
        event entity_transformed
    }
}
