entity minecraft:vindicator {
    spawn_category monster
    is_spawnable #true
    is_summonable #true
    components {
        attack damage=8
        behavior.avoid_mob_type {
            entity_type {
                filters test=is_family subject=other value=creaking
                max_dist 8
                sprint_speed_multiplier 1.2
            }
            priority 2
        }
        behavior.equip_item priority=3
        behavior.float priority=0
        behavior.hurt_by_target {
            entity_types {
                filters test=is_family subject=other operator="!=" value=illager
                max_dist 64
            }
            priority 1
        }
        behavior.look_at_player look_distance=8 priority=10 probability=0.02
        behavior.melee_box_attack priority=3
        behavior.pickup_items goal_radius=2 max_dist=3 priority=7 speed_multiplier=1.0
        behavior.random_stroll priority=9 speed_multiplier=1
        breathable suffocate_time=0 total_supply=15
        can_join_raid
        collision_box height=1.9 width=0.6
        conditional_bandwidth_optimization
        equip_item
        equipment table="loot_tables/entities/vindicator_gear.json"
        experience_reward on_death="query.last_hit_by_player ? (query.is_baby ? 12 : 5) + (Math.die_roll(query.equipment_count,1,3)) : 0"
        follow_range 64
        health 24 max=24
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        loot table="loot_tables/entities/vindication_illager.json"
        movement 0.35
        movement.basic
        nameable {
            default_trigger {
                event minecraft:stop_johnny
                target self
            }
            name_action {
                name_filter Johnny
                on_named {
                    event minecraft:start_johnny
                    target self
                }
            }
        }
        navigation.walk can_path_over_water=#true
        on_target_acquired event=minecraft:become_aggro target=self
        on_target_escape event=minecraft:stop_aggro target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        shareables {
            item item=minecraft:banner:15 priority=0 surplus_amount=1 want_amount=1
        }
        type_family {
            family vindicator
            family monster
            family illager
            family mob
        }
        variant 0
    }
    component_groups {
        group celebrate {
            behavior.celebrate {
                celebration_sound celebrate
                duration 30.0
                jump_interval {
                    range_max 3.5
                    range_min 1.0
                }
                on_celebration_end_event {
                    event minecraft:stop_celebrating
                    target self
                }
                priority 5
                sound_interval {
                    range_max 7.0
                    range_min 2.0
                }
            }
        }
        group default_targeting {
            behavior.nearest_attackable_target {
                entity_type {
                    filters {
                        any_of {
                            filter test=is_family subject=other value=player
                            filter test=is_family subject=other value=snowgolem
                            filter test=is_family subject=other value=irongolem
                            filter test=is_family subject=other value=wandering_trader
                        }
                    }
                    max_dist 12
                }
                entity_type {
                    filters {
                        filter test=is_family subject=other value=villager
                        filter test=has_component subject=other operator="!=" value=minecraft:is_baby
                    }
                    max_dist 12
                }
                must_see #true
                must_see_forget_duration 40.0
                priority 2
                within_radius 12.0
            }
        }
        group illager_squad_captain {
            equipment {
                entry drop_chance=1.0 slot=slot.armor.chest
                table "loot_tables/entities/vindicator_captain_equipment.json"
            }
            is_illager_captain
            loot table="loot_tables/entities/pillager_captain.json"
            variant 1
        }
        group patrol_captain {
            behavior.move_to_random_block block_distance=512 priority=5 speed_multiplier=0.55 within_radius=8
            equipment {
                entry drop_chance=1.0 slot=slot.armor.chest
                table "loot_tables/entities/vindicator_captain_equipment.json"
            }
            is_illager_captain
            loot table="loot_tables/entities/pillager_captain.json"
            variant 1
        }
        group patrol_follower {
            behavior.follow_target_captain follow_distance=5 priority=5 speed_multiplier=0.8 within_radius=64
        }
        group raid_configuration {
            ambient_sound_interval 2.0 event_name=ambient.in.raid range=4.0
            annotation.break_door break_time=30 min_difficulty=normal
            behavior.move_to_village goal_radius=2.0 priority=4 speed_multiplier=1.0
            dweller {
                can_find_poi #false
                can_migrate #true
                dweller_role hostile
                dwelling_type village
                first_founding_reward 0
                update_interval_base 60
                update_interval_variant 40
            }
            loot table="loot_tables/entities/vindicator_raid.json"
            navigation.walk can_break_doors=#true can_pass_doors=#true can_path_over_water=#true
        }
        group raid_despawn {
            despawn {
                despawn_from_distance
            }
        }
        group raid_persistence {
            persistent
        }
        group vindicator_aggro {
            angry {
                broadcast_anger #false
                calm_event {
                    event minecraft:stop_aggro
                    target self
                }
                duration -1
            }
        }
        group vindicator_johnny {
            behavior.nearest_attackable_target {
                entity_type {
                    filters test=is_family subject=other operator="!=" value=illager
                    max_dist 12
                }
                must_see #true
                must_see_forget_duration 40.0
                priority 2
                within_radius 12.0
            }
        }
    }
    events {
        event become_aggro {
            add minecraft:vindicator_aggro
        }
        event entity_spawned {
            add minecraft:default_targeting
        }
        event promote_to_illager_captain {
            add minecraft:default_targeting
            add minecraft:illager_squad_captain
            remove minecraft:patrol_follower
        }
        event promote_to_patrol_captain {
            add minecraft:default_targeting
            add minecraft:patrol_captain
            remove minecraft:patrol_follower
        }
        event raid_expired
        event spawn_as_illager_captain {
            add minecraft:default_targeting
            add minecraft:illager_squad_captain
        }
        event spawn_as_patrol_follower {
            add minecraft:default_targeting
            add minecraft:patrol_follower
        }
        event spawn_for_raid {
            add minecraft:default_targeting
            add minecraft:raid_configuration
            add minecraft:raid_persistence
            add minecraft:raid_despawn
        }
        event start_celebrating
        event start_johnny {
            add minecraft:vindicator_johnny
        }
        event stop_aggro {
            remove minecraft:vindicator_aggro
        }
        event stop_celebrating {
            remove minecraft:celebrate
        }
        event stop_johnny {
            add minecraft:default_targeting
            remove minecraft:vindicator_johnny
        }
    }
}
entity minecraft:wandering_trader {
    spawn_category creature
    is_spawnable #true
    is_summonable #true
    components {
        behavior.avoid_mob_type {
            entity_type {
                filters {
                    any_of {
                        filter test=is_family subject=other value=zombie
                        filter test=is_family subject=other value=zombie_villager
                        filter test=is_family subject=other value=zombie_pigman
                        filter test=is_family subject=other value=illager
                        filter test=is_family subject=other value=vex
                        filter test=is_family subject=other value=zoglin
                    }
                }
                sprint_speed_multiplier 0.6
                walk_speed_multiplier 0.6
            }
            max_dist 6
            priority 2
        }
        behavior.drink_milk {
            filters {
                filter test=is_daytime value=#true
                filter test=is_visible subject=self value=#false
                filter test=is_avoiding_mobs subject=self value=#false
            }
            priority 5
        }
        behavior.drink_potion {
            potion {
                chance 1.0
                filters {
                    filter {
                        any_of {
                            filter test=hourly_clock_time operator=">=" value=18000
                            filter test=hourly_clock_time operator=< value=12000
                        }
                    }
                    filter test=is_visible subject=self value=#true
                    filter {
                        any_of {
                            filter test=is_avoiding_mobs subject=self value=#true
                            filter {
                                filter test=has_component subject=self value=minecraft:angry
                                filter test=is_family subject=target operator="!=" value=player
                            }
                        }
                    }
                }
                id 7
            }
            potion {
                chance 1.0
                filters {
                    filter test=hourly_clock_time operator=">=" value=12000
                    filter test=hourly_clock_time operator=< value=18000
                    filter test=is_visible subject=self value=#true
                    filter {
                        any_of {
                            filter test=is_avoiding_mobs subject=self value=#true
                            filter test=has_component subject=self value=minecraft:angry
                        }
                    }
                }
                id 8
            }
            priority 1
            speed_modifier -0.2
        }
        behavior.float priority=0
        behavior.look_at_player look_distance=8 priority=8 probability=0.02
        behavior.look_at_trading_player priority=4
        behavior.move_towards_home_restriction priority=6 speed_multiplier=0.6
        behavior.panic priority=1 speed_multiplier=0.6
        behavior.random_look_around priority=9
        behavior.random_stroll priority=7 speed_multiplier=0.6
        behavior.trade_interest carried_item_switch_time=2.0 cooldown=2.0 interest_time=45.0 priority=3 remove_item_time=1.0 within_radius=6.0
        behavior.trade_with_player {
            filters {
                filter {
                    filter test=in_water value=#false
                }
                filter {
                    any_of {
                        filter test=on_ground value=#true
                        filter test=is_sleeping value=#true
                    }
                }
            }
            priority 1
        }
        breathable suffocate_time=0 total_supply=15
        can_climb
        collision_box height=1.9 width=0.6
        conditional_bandwidth_optimization
        damage_sensor {
            trigger {
                cause entity_attack
                deals_damage #true
                on_damage {
                    event minecraft:become_scared
                }
            }
            trigger {
                cause projectile
                deals_damage #true
                on_damage {
                    event minecraft:become_scared
                }
            }
            trigger {
                cause magic
                deals_damage #true
                on_damage {
                    event minecraft:become_scared
                }
            }
        }
        despawn {
            filters {
                filter {
                    any_of {
                        filter test=is_family subject=self value=wandering_trader_despawning
                        filter test=has_trade_supply subject=self value=#false
                    }
                }
                filter test=distance_to_nearest_player operator=> value=24
            }
            remove_child_entities #true
        }
        economy_trade_table display_name=entity.wandering_trader.name new_screen=#true table="trading/economy_trades/wandering_trader_trades.json"
        health 20 max=20
        home restriction_radius=16
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        movement 0.5
        movement.basic
        nameable
        navigation.walk avoid_water=#true can_open_doors=#false can_pass_doors=#true can_path_over_water=#true
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        spawn_entity {
            entitie {
                max_wait_time 0
                min_wait_time 0
                num_to_spawn 2
                should_leash #true
                single_use #true
                spawn_entity trader_llama
                spawn_event minecraft:from_wandering_trader
            }
        }
        timer {
            looping #false
            random_time_choice value=2400 weight=50
            random_time_choice value=3600 weight=50
            time_down_event {
                event minecraft:start_despawn
                target self
            }
        }
        type_family {
            family wandering_trader
            family mob
        }
    }
    component_groups {
        group despawning {
            type_family {
                family wandering_trader
                family wandering_trader_despawning
                family mob
            }
        }
        group managed {
            managed_wandering_trader
        }
        group scared {
            angry {
                broadcastAnger #true
                broadcastRange 10
                broadcast_filters {
                    subject other
                    test is_leashed_to
                    value #true
                }
                broadcast_target llama
                broadcast_target trader_llama
                calm_event {
                    event minecraft:become_calm
                    target self
                }
                duration 5
            }
        }
    }
    events {
        event become_calm {
            remove minecraft:scared
        }
        event become_scared {
            add minecraft:scared
        }
        event scheduled {
            add managed
        }
        event start_despawn {
            add despawning
        }
    }
}
entity minecraft:warden {
    spawn_category monster
    is_spawnable #true
    is_summonable #true
