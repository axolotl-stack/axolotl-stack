                    baby_type minecraft:cow
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:cow
                }
                property_inheritance {
                    minecraft:climate_variant
                }
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            interact {
                interaction {
                    interact_text action.interact.milk
                    on_interact {
                        filters {
                            filter test=is_family subject=other value=player
                            filter test=has_equipment subject=other domain=hand value=bucket:0
                        }
                    }
                    play_sounds milk
                    transform_to_item bucket:1
                    use_item #true
                }
            }
            leashable_to
            loot table="loot_tables/entities/cow.json"
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.15
                    seat 0.0
                }
            }
        }
        group cow_baby {
            ageable {
                duration 1200
                feed_items wheat
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=6 speed_multiplier=1.1
            is_baby
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 1.0
                    seat 0.0
                }
            }
            scale 0.5
        }
    }
    events {
