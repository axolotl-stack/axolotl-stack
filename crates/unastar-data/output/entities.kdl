            behavior.follow_parent priority=4 speed_multiplier=1.0
            is_baby
            scale_by_age end_scale=1.0 start_scale=0.5
        }
        group donkey_chested {
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_family subject=other value=player
                            filter test=is_sneaking subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            is_chested
        }
        group donkey_saddled {
            can_power_jump
            input_ground_controlled
            is_saddled
        }
        group donkey_tamed {
            behavior.player_ride_tamed
            breedable {
                breed_item golden_carrot
                breed_item golden_apple
                breed_item appleEnchanted
                entry {
                    baby_type minecraft:donkey
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:donkey
                }
                entry {
                    baby_type minecraft:mule
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:horse
                }
                inherit_tamed #false
                entry minecraft:health
                require_tame #true
            }
            equippable {
                slot {
                    accepted_item saddle
                    item saddle
                    on_equip {
                        event minecraft:donkey_saddled
                    }
                    on_unequip {
                        event minecraft:donkey_unsaddled
                    }
                    slot 0
                }
            }
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.equip
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
            }
            inventory container_type=horse inventory_size=16
            is_tamed
            rideable {
                crouching_skip_interact #true
                family_type player
                interact_text action.interact.ride.horse
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.925
                    seat -0.2
                }
            }
        }
        group donkey_unchested {
            interact {
                interaction {
                    equip_item_slot "0"
                    interact_text action.interact.saddle
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=saddle
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                }
                interaction {
                    drop_item_slot "0"
                    drop_item_y_offset 1.1
                    hurt_item 1
                    interact_text action.interact.removesaddle
                    on_interact {
                        filters {
                            filter test=rider_count subject=self operator=equals value=0
                            filter test=has_equipment subject=self domain=inventory value=saddle
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_sneak_held subject=other value=#false
                        }
                    }
                    play_sounds unsaddle
                    vibration shear
                }
                interaction {
                    interact_text action.interact.attachchest
                    on_interact {
                        event minecraft:on_chest
                        filters {
                            filter test=is_sneaking subject=other value=#false
                            filter test=has_equipment subject=other domain=hand value=chest
                        }
                        target self
                    }
                    play_sounds armor.equip_generic
                    use_item #true
                }
            }
        }
        group donkey_wild {
            behavior.mount_pathing priority=2 speed_multiplier=1.5 target_dist=0.0 track_target=#true
            rideable {
                family_type player
                family_type baby_zombie
                family_type baby_husk
                interact_text action.interact.mount
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.925
                    seat -0.2
                }
            }
            tamemount {
                auto_reject_item item=horsearmorleather
                auto_reject_item item=horsearmoriron
                auto_reject_item item=horsearmorgold
                auto_reject_item item=horsearmordiamond
                auto_reject_item item=minecraft:copper_horse_armor
                auto_reject_item item=minecraft:netherite_horse_armor
                auto_reject_item item=saddle
                feed_item item=wheat temper_mod=3
                feed_item item=sugar temper_mod=3
                feed_item item=apple temper_mod=3
                feed_item item=carrot temper_mod=3
                feed_item item=golden_carrot temper_mod=5
                feed_item item=golden_apple temper_mod=10
                feed_item item=appleEnchanted temper_mod=10
                feed_text action.interact.feed
                max_temper 100
                min_temper 0
                ride_text action.interact.mount
                tame_event {
                    event minecraft:on_tame
                    target self
                }
            }
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:donkey_adult
            add minecraft:donkey_wild
            remove minecraft:donkey_baby
        }
        event donkey_saddled {
            add minecraft:donkey_saddled
        }
        event donkey_unsaddled {
            remove minecraft:donkey_saddled
        }
        event entity_born {
            add minecraft:donkey_baby
        }
        event entity_spawned {
            randomize {
                option weight=80
                option weight=20
            }
        }
        event on_chest {
            add minecraft:donkey_chested
            remove minecraft:donkey_unchested
        }
        event on_tame {
            add minecraft:donkey_tamed
            add minecraft:donkey_unchested
            remove minecraft:donkey_wild
        }
        event spawn_adult {
            add minecraft:donkey_adult
            add minecraft:donkey_wild
        }
        event spawn_tame_adult {
            add minecraft:donkey_adult
            add minecraft:donkey_tamed
            add minecraft:donkey_unchested
        }
    }
}
