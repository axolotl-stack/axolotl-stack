        water_movement drag_factor=0.9
    }
    component_groups {
        group adult {
            behavior.breed priority=2 speed_multiplier=1.0
            behavior.move_to_land goal_radius=0.5 priority=6 search_height=5 search_range=16
            behavior.random_stroll interval=100 priority=9
            breedable {
                breed_item seagrass
                breeds_with {
                    baby_type minecraft:turtle
                    breed_event {
                        event minecraft:become_pregnant
                        target self
                    }
                    mate_type minecraft:turtle
                }
                causes_pregnancy #true
                require_tame #false
            }
            collision_box height=0.4 width=1.2
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            loot table="loot_tables/entities/sea_turtle.json"
