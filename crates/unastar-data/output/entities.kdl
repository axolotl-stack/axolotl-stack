        health 15 max=15
        home
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava
            }
        }
        is_hidden_when_invisible
        knockback_resistance 0.3
        loot table="loot_tables/entities/nautilus.json"
        mob_effect_immunity {
            mob_effect poison
        }
        movement.sway sway_amplitude=0.0
        nameable
        navigation.generic can_breach=#false can_path_over_water=#false can_sink=#false can_swim=#true can_walk=#false is_amphibious=#false
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family aquatic
            family nautilus
            family mob
        }
    }
    component_groups {
        group nautilus_adult {
            behavior.breed priority=3 speed_multiplier=1.0
