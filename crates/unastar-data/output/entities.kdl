        behavior.look_at_player look_distance=8 priority=6
        behavior.melee_attack priority=4 reach_multiplier=0.0 speed_multiplier=1.25 track_target=#false
        behavior.nearest_attackable_target {
            entity_type {
                filters test=is_family subject=other value=player
                max_dist 16
            }
            must_see #true
            must_see_forget_duration 3.0
            priority 1
