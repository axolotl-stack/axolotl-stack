                angry_sound angry
                broadcast_anger #false
                broadcast_anger_on_attack #false
                broadcast_anger_on_being_attacked #true
                broadcast_range 16
                broadcast_target piglin
                calm_event {
                    event become_calm_event
                    target self
                }
                duration 30
                filters {
                    filter test=is_family subject=other operator="!=" value=piglin
                }
                sound_interval {
                    range_max 5.0
                    range_min 2.0
                }
            }
        }
        group become_zombie {
            transformation into=minecraft:zombie_pigman keep_level=#true preserve_equipment=#true transformation_sound=converted_to_zombified
        }
        group go_back_to_spawn {
            behavior.go_home {
                goal_radius 4.0
                interval 200
                entry event=go_back_to_spawn_failed target=self
                priority 6
                speed_multiplier 0.6
            }
        }
        group melee_unit {
            attack damage=7
            behavior.melee_box_attack priority=4 speed_multiplier=1 track_target=#true
            equipment table="loot_tables/entities/piglin_brute_gear.json"
            variant 1
        }
        group start_zombification {
            environment_sensor {
                triggers {
                    event stop_zombification_event
                    filters test=in_nether subject=self operator="==" value=#true
                }
            }
            is_shaking
            timer {
                looping #false
                time 15
                time_down_event {
                    event become_zombie_event
                }
            }
        }
        group take_target_as_response_to_block_break {
            behavior.nearest_attackable_target {
                entity_type {
                    filters test=is_family subject=other value=player
                    max_dist 16
                }
                priority 3
            }
        }
        group zombification_sensor {
            environment_sensor {
                triggers {
                    event start_zombification_event
                    filters test=in_nether subject=self operator="==" value=#false
                }
            }
        }
    }
    events {
        event become_angry_event {
            add angry
        }
        event become_calm_event {
            add alert_for_attack_targets
            remove angry
        }
        event become_zombie_event {
            add become_zombie
        }
        event go_back_to_spawn_failed {
            remove go_back_to_spawn
        }
        event important_block_destroyed_event {
            add take_target_as_response_to_block_break
            remove alert_for_attack_targets
        }
        event entity_spawned {
            add zombification_sensor
            add alert_for_attack_targets
            add melee_unit
            add go_back_to_spawn
        }
        event start_zombification_event {
            add start_zombification
            remove zombification_sensor
        }
        event stop_zombification_event {
            add zombification_sensor
            remove start_zombification
        }
    }
}
entity minecraft:pillager {
