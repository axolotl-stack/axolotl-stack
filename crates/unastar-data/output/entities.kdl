            item minecraft:lilac
            item minecraft:rose_bush
            item minecraft:peony
            item minecraft:flowering_azalea
            item minecraft:azalea_leaves_flowered
            item minecraft:mangrove_propagule
            item minecraft:pitcher_plant
            item minecraft:torchflower
            item minecraft:cherry_leaves
            item minecraft:pink_petals
            item minecraft:open_eyeblossom
            item minecraft:wildflowers
            item minecraft:cactus_flower
            priority 5
            speed_multiplier 1.25
            within_radius 8
        }
        block_sensor {
            entry {
                entry minecraft:beehive
                entry minecraft:bee_nest
                on_block_broken hive_destroyed
            }
            sensor_radius 16
            source subject=other test=has_silk_touch value=#false
        }
        breathable suffocateTime=-1 totalSupply=0
        can_fly
        collision_box height=0.5 width=0.55
        conditional_bandwidth_optimization
        damage_sensor {
            trigger cause=fall deals_damage=no
            trigger {
                deals_damage no
                on_damage {
                    filters test=is_block subject=block value=minecraft:sweet_berry_bush
                }
            }
        }
        flying_speed 0.15
        follow_range 1024
        game_event_movement_tracking emit_flap=#true
        health 10 max=10
        home {
            entry minecraft:bee_nest
            entry minecraft:beehive
            restriction_radius 22
            restriction_type random_movement
        }
        hurt_on_condition {
            condition {
                cause lava
                damage_per_tick 4
                filters test=in_lava subject=self
            }
        }
        interact {
            interaction {
                interact_text action.interact.feed
                on_interact {
                    event fed_open_eyeblossom
                    filters {
                        filter test=is_family subject=other value=player
                        filter test=has_equipment subject=other domain=hand value=minecraft:open_eyeblossom
                    }
                }
                particle_on_start {
                    particle_type food
                }
                use_item #true
            }
            interaction {
                interact_text action.interact.feed
                on_interact {
                    event fed_wither_rose
                    filters {
                        filter test=is_family subject=other value=player
                        filter test=has_equipment subject=other domain=hand value=minecraft:wither_rose
                    }
                }
                particle_on_start {
                    particle_type food
                }
                use_item #true
            }
        }
        is_hidden_when_invisible
        jump.static
        leashable
        movement 0.3
        movement.hover
        nameable
        navigation.hover {
            avoid_damage_blocks #true
            avoid_sun #false
            avoid_water #true
            can_pass_doors #false
            can_path_from_air #true
            can_path_over_water #true
            can_sink #false
        }
        on_target_acquired event=attacked target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family bee
            family mob
            family arthropod
        }
    }
    component_groups {
        group abort_shelter_detection {
            environment_sensor {
                trigger {
                    event abort_sheltering
                    filters {
                        filter test=weather operator="==" value=clear
                        filter test=is_daytime value=#true
                    }
                }
            }
        }
        group add_poison_effect {
            behavior.timer_flag_1 {
                cooldown_range 0.0
                entry 0.05
                entry 0.05
                on_end {
                    event minecraft:on_poison_effect_added
                    target self
                }
                priority 0
            }
            spell_effects {
                add_effect display_on_screen_animation=#true duration=25 effect=poison
                remove_effects poison
            }
        }
        group add_wither_effect {
            behavior.timer_flag_1 {
                cooldown_range 0.0
                entry 0.05
                entry 0.05
                on_end {
                    event minecraft:on_wither_effect_added
                    target self
                }
                priority 0
            }
            spell_effects {
                add_effect display_on_screen_animation=#true duration=40 effect=wither
                remove_effects wither
            }
        }
        group angry_bee {
            angry {
                broadcastAnger #true
                broadcastRange 20
                broadcast_anger_when_dying #false
                broadcast_filters {
                    operator "!="
                    test is_family
                    value pacified
                }
                calm_event {
                    event calmed_down
                    target self
                }
                duration 25
            }
            behavior.melee_box_attack {
                attack_once #true
                on_attack {
                    event countdown_to_perish_event
                    target self
                }
                priority 2
                speed_multiplier 1.4
            }
        }
        group bee_adult {
            behavior.breed priority=4 speed_multiplier=1.0
            breedable {
                breed_item minecraft:poppy
                breed_item minecraft:blue_orchid
                breed_item minecraft:allium
                breed_item minecraft:azure_bluet
                breed_item minecraft:red_tulip
                breed_item minecraft:orange_tulip
                breed_item minecraft:white_tulip
                breed_item minecraft:pink_tulip
                breed_item minecraft:oxeye_daisy
                breed_item minecraft:cornflower
                breed_item minecraft:lily_of_the_valley
                breed_item minecraft:dandelion
                breed_item minecraft:wither_rose
                breed_item minecraft:sunflower
                breed_item minecraft:lilac
                breed_item minecraft:rose_bush
                breed_item minecraft:peony
                breed_item minecraft:flowering_azalea
                breed_item minecraft:azalea_leaves_flowered
                breed_item minecraft:mangrove_propagule
                breed_item minecraft:pitcher_plant
                breed_item minecraft:torchflower
                breed_item minecraft:cherry_leaves
                breed_item minecraft:pink_petals
                breed_item minecraft:wildflowers
                breed_item minecraft:cactus_flower
                breeds_with {
                    baby_type minecraft:bee
                    breed_event {
                        event minecraft:entity_born
                        target baby
                    }
                    mate_type minecraft:bee
                }
                require_tame #false
            }
            experience_reward on_bred="Math.Random(1,7)" on_death="query.last_hit_by_player ? Math.Random(1,3) : 0"
            leashable_to
        }
        group bee_baby {
            ageable {
                duration 1200
                feed_item minecraft:poppy
                feed_item minecraft:blue_orchid
                feed_item minecraft:allium
                feed_item minecraft:azure_bluet
                feed_item minecraft:red_tulip
                feed_item minecraft:orange_tulip
                feed_item minecraft:white_tulip
                feed_item minecraft:pink_tulip
                feed_item minecraft:oxeye_daisy
                feed_item minecraft:cornflower
                feed_item minecraft:lily_of_the_valley
                feed_item minecraft:dandelion
                feed_item minecraft:wither_rose
                feed_item minecraft:sunflower
                feed_item minecraft:lilac
                feed_item minecraft:rose_bush
                feed_item minecraft:peony
                feed_item minecraft:flowering_azalea
                feed_item minecraft:azalea_leaves_flowered
                feed_item minecraft:mangrove_propagule
                feed_item minecraft:pitcher_plant
                feed_item minecraft:torchflower
                feed_item minecraft:cherry_leaves
                feed_item minecraft:pink_petals
                feed_item minecraft:wildflowers
                feed_item minecraft:cactus_flower
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.follow_parent priority=11 speed_multiplier=1.1
            is_baby
            scale 0.5
        }
        group countdown_to_perish {
            behavior.panic force=#true priority=1 speed_multiplier=1.25
            mark_variant 1
            timer {
                looping #false
                randomInterval #true
                entry 10
                entry 60
                time_down_event {
                    event perish_event
                    target self
                }
            }
            type_family {
                family bee
                family mob
                family arthropod
                family pacified
            }
        }
        group default_sound {
            ambient_sound_interval 0.0 event_name=ambient range=0.0
        }
        group easy_attack {
            attack damage=2
        }
        group escape_fire {
            behavior.panic force=#true priority=1 speed_multiplier=1.25
            timer {
                looping #false
                randomInterval #true
                entry 20
                entry 50
                time_down_event {
                    event stop_panicking_after_fire
                    target self
                }
            }
        }
        group find_hive {
            behavior.move_to_block {
                goal_radius 0.633
                entry event=minecraft:bee_returned_to_hive target=block
                priority 10
                search_height 10
                search_range 16
                target_block bee_nest
                target_block beehive
                tick_interval 1
            }
            timer {
                looping #false
                time 180
                time_down_event {
                    event find_hive_timeout
                    target self
                }
            }
        }
        group hard_attack {
            attack damage=2 effect_duration=18 effect_name=poison
        }
        group has_nectar {
            grows_crop chance=0.03 charges=10
        }
        group hive_full {
            timer {
                looping #false
                randomInterval #true
                entry 5
                entry 20
                time_down_event {
                    event find_hive_event
                    target self
                }
            }
        }
        group look_for_food {
            ambient_sound_interval 2.0 event_name=ambient.pollinate range=3.0
            behavior.move_to_block {
                goal_radius 1.0
                entry event=collected_nectar target=self
                priority 10
                search_height 4
                search_range 6
                start_chance 0.5
                stay_duration 20.0
                target_block_filters {
                    operator "=="
                    subject block
                    test is_waterlogged
                    value #false
                }
                target_block minecraft:poppy
                target_block minecraft:blue_orchid
                target_block minecraft:allium
                target_block minecraft:azure_bluet
                target_block minecraft:red_tulip
                target_block minecraft:orange_tulip
                target_block minecraft:white_tulip
                target_block minecraft:pink_tulip
                target_block minecraft:oxeye_daisy
                target_block minecraft:cornflower
                target_block minecraft:lily_of_the_valley
                target_block minecraft:dandelion
                target_block minecraft:wither_rose
                target_block minecraft:sunflower
                target_block minecraft:lilac
                target_block minecraft:rose_bush
                target_block minecraft:peony
                target_block minecraft:flowering_azalea
                target_block minecraft:azalea_leaves_flowered
                target_block minecraft:mangrove_propagule
                target_block minecraft:pitcher_plant
                target_block minecraft:torchflower
                target_block minecraft:cherry_leaves
                target_block minecraft:pink_petals
                target_block minecraft:open_eyeblossom
                target_block minecraft:wildflowers
                target_block minecraft:cactus_flower
                entry 0
                entry 0.25
                entry 0
                target_selection_method random
                tick_interval 1
            }
            timer {
                looping #true
                time 180
                time_down_event {
                    event find_flower_timeout
                }
            }
        }
        group normal_attack {
            attack damage=2 effect_duration=10 effect_name=poison
        }
        group perish {
            hurt_on_condition {
                condition cause=none damage_per_tick=999
            }
        }
        group return_to_home {
            behavior.go_home {
                goal_radius 1.2
                interval 1
                entry event=find_hive_event target=self
                entry {
                    event minecraft:bee_returned_to_hive
                    filters {
                        any_of {
                            filter test=is_block subject=block value=minecraft:bee_nest
                            filter test=is_block subject=block value=minecraft:beehive
                        }
                    }
                    target block
                }
                entry {
                    event find_hive_event
                    filters {
                        filter test=is_block subject=block operator="!=" value=minecraft:bee_nest
                        filter test=is_block subject=block operator="!=" value=minecraft:beehive
                    }
                    target self
                }
                priority 4
                speed_multiplier 1.0
            }
        }
        group shelter_detection {
            environment_sensor {
                trigger {
                    event seek_shelter
                    filters {
                        filter {
                            any_of {
                                filter test=is_daytime value=#false
                                filter test=weather operator="==" value=precipitation
                            }
                        }
                        filter test=bool_property operator="!=" domain=minecraft:has_nectar
                        filter test=has_biome_tag value=overworld
                    }
                }
            }
        }
        group take_nearest_target {
            behavior.nearest_attackable_target {
                entity_type {
                    filters test=is_family subject=other value=player
                    max_dist 10
                }
                priority 2
            }
            timer {
                looping #true
                time 5
                time_down_event {
                    event calmed_down
                    target self
                }
            }
        }
        group track_attacker {
            behavior.hurt_by_target priority=1
        }
    }
    events {
        event abort_sheltering {
            add shelter_detection
            add look_for_food
            remove abort_shelter_detection
            remove return_to_home
            remove escape_fire
        }
        event attacked
        event calmed_down {
            add shelter_detection
            add return_to_home
            remove angry_bee
            remove take_nearest_target
        }
        event collected_nectar {
            add return_to_home
            add has_nectar
            add default_sound
            remove look_for_food
        }
        event countdown_to_perish_event {
            add countdown_to_perish
            remove collect_nectar
            remove track_attacker
            remove take_nearest_target
            remove look_for_food
            remove angry_bee
            remove hive_full
            remove find_hive
            remove escape_fire
        }
        event fed_open_eyeblossom {
            add add_poison_effect
        }
        event fed_wither_rose {
            add add_wither_effect
        }
        event find_flower_timeout {
            add return_to_home
            remove look_for_food
        }
        event find_hive_event {
            add find_hive
            remove return_to_home
            remove hive_full
        }
        event find_hive_timeout
        event hive_destroyed
        event ageable_grow_up {
            add bee_adult
            remove bee_baby
        }
        event entity_born {
            add bee_baby
            add shelter_detection
            add track_attacker
            add look_for_food
        }
        event entity_spawned
        event exited_disturbed_hive {
            add take_nearest_target
            remove find_hive
            remove return_to_home
            remove has_nectar
            remove abort_shelter_detection
            remove shelter_detection
            remove escape_fire
        }
        event exited_hive {
            add look_for_food
            add shelter_detection
            remove find_hive
            remove return_to_home
            remove has_nectar
            remove abort_shelter_detection
        }
        event exited_hive_on_fire {
            add escape_fire
        }
        event hive_full {
            add hive_full
            remove find_hive
            remove return_to_home
        }
        event spawn_adult {
            add bee_adult
            add shelter_detection
            add track_attacker
            add look_for_food
        }
        event on_poison_effect_added {
            remove add_poison_effect
        }
        event on_wither_effect_added {
            remove add_wither_effect
        }
        event perish_event {
            add perish
        }
        event seek_shelter {
            add default_sound
            add return_to_home
            add abort_shelter_detection
            remove look_for_food
            remove collect_nectar
            remove shelter_detection
        }
        event stop_panicking_after_fire {
            remove escape_fire
        }
    }
}
entity minecraft:blaze {
    spawn_category monster
    is_spawnable #true
    is_summonable #true
    components {
        behavior.float priority=0
        behavior.hurt_by_target priority=1
        behavior.nearest_attackable_target {
            entity_type {
                filters test=is_family subject=other value=player
                max_dist 48.0
            }
            must_see #true
            priority 2
        }
        behavior.random_look_around priority=5
        behavior.random_stroll priority=4 speed_multiplier=1.0
        can_climb
        collision_box height=1.8 width=0.5
        conditional_bandwidth_optimization
        damage_sensor {
            triggers {
                cause fall
                deals_damage no
            }
        }
        despawn {
            despawn_from_distance
        }
        experience_reward on_death="query.last_hit_by_player ? 10 : 0"
        fire_immune
        follow_range 48 max=48
        health 20 max=20
        hurt_on_condition {
            condition {
                cause drowning
                damage_per_tick 1
                filters test=in_contact_with_water
            }
        }
        is_hidden_when_invisible
        jump.static
        loot table="loot_tables/entities/blaze.json"
        movement 0.23
        movement.basic
        nameable
        navigation.walk avoid_damage_blocks=#true avoid_water=#true can_path_over_water=#true
        on_hurt event=minecraft:on_hurt_event target=self
        on_hurt_by_player event=minecraft:on_hurt_event target=self
        physics
        pushable is_pushable=#true is_pushable_by_piston=#true
        type_family {
            family blaze
            family monster
            family mob
        }
    }
    component_groups {
        group melee_mode {
            attack damage=6
            behavior.melee_box_attack priority=3
        }
        group mode_switcher {
            target_nearby_sensor {
                inside_range 2.0
                must_see #true
                on_inside_range {
                    event switch_to_melee
                    target self
                }
                on_outside_range {
                    event switch_to_ranged
                    target self
                }
                outside_range 3.0
            }
        }
        group ranged_mode {
            behavior.ranged_attack {
                attack_interval_max 5.0
                attack_interval_min 3.0
                attack_radius 48.0
                burst_interval 0.3
                burst_shots 3
                charge_charged_trigger 0.0
                charge_shoot_trigger 4.0
                priority 3
            }
            shooter def=minecraft:small_fireball
        }
    }
    events {
        event entity_spawned {
            add mode_switcher
        }
        event on_hurt_event {
            add mode_switcher
        }
        event switch_to_melee {
            add melee_mode
            remove ranged_mode
        }
        event switch_to_ranged {
            add ranged_mode
            remove melee_mode
        }
    }
}
entity minecraft:boat {
    is_spawnable #false
    is_summonable #true
    components {
        balloonable
        buoyant {
            apply_gravity #true
            base_buoyancy 1.0
            big_wave_probability 0.03
            big_wave_speed 10.0
            liquid_block minecraft:water
            liquid_block minecraft:flowing_water
            simulate_waves #true
        }
        collision_box height=0.455 width=1.4
        conditional_bandwidth_optimization {
            conditional_value {
                conditional_value subject=self test=is_moving
                max_dropped_ticks 0
