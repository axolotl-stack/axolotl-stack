        event navigation_on_land {
            add dolphin_on_land
            remove dolphin_swimming_navigation
        }
        event on_calm {
            remove dolphin_angry
        }
        event recover_after_dried_out {
            remove dolphin_dried
        }
        event start_dryingout {
            add dolphin_on_land
            remove dolphin_on_land_in_rain
        }
        event stop_dryingout {
            add dolphin_on_land_in_rain
            remove dolphin_on_land
            remove dolphin_dried
        }
    }
}
