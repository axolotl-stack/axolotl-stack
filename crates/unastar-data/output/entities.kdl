        group wolf_angry {
            angry {
                broadcast_anger #true
                broadcast_anger_when_dying #false
                broadcast_range 20
                calm_event {
                    event minecraft:on_calm
                    target self
                }
                duration 25
            }
            on_target_acquired
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.625
                    seat -0.1
                }
            }
        }
        group wolf_armorable {
            interact {
                interaction {
                    equip_item_slot slot.armor.body
                    interact_text action.interact.equipwolfarmor
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self operator=not domain=armor value=wolf_armor
                            filter test=has_equipment subject=other domain=hand value=wolf_armor
                            filter test=is_family subject=other value=player
                            filter test=is_owner subject=other value=#true
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.equip_wolf
                }
                interaction {
                    drop_item_slot slot.armor.body
                    hurt_item 1
                    interact_text action.interact.removewolfarmor
                    on_interact {
                        filters {
                            filter test=has_equipment subject=self domain=armor value=wolf_armor
                            filter test=has_equipment subject=other domain=hand value=shears
                            filter test=is_family subject=other value=player
                            filter test=is_owner subject=other value=#true
                            filter test=is_sneak_held subject=other value=#false
                        }
                        target self
                    }
                    play_sounds armor.unequip_wolf
                    vibration shear
                }
                interaction {
                    interact_text action.interact.repairwolfarmor
                    on_interact {
                        filters {
                            filter test=is_sitting subject=self
                            filter test=has_damaged_equipment subject=self domain=armor value=wolf_armor
                            filter test=is_family subject=other value=player
                            filter test=is_owner subject=other value=#true
                            filter test=is_sneak_held subject=other value=#false
                            filter test=has_equipment subject=other domain=hand value=armadillo_scute
                        }
                        target self
                    }
                    play_sounds armor.repair_wolf
                    repair_entity_item {
                        amount 8
                        slot slot.armor.body
                    }
                    use_item #true
                }
            }
        }
        group wolf_ashen {
            variant 1
        }
        group wolf_baby {
            ageable {
                duration 1200
                feed_item chicken
                feed_item cooked_chicken
                feed_item beef
                feed_item cooked_beef
                feed_item muttonRaw
                feed_item muttonCooked
                feed_item porkchop
                feed_item cooked_porkchop
                feed_item rabbit
                feed_item cooked_rabbit
                feed_item rotten_flesh
                grow_up {
                    event minecraft:ageable_grow_up
                    target self
                }
            }
            behavior.panic priority=1 speed_multiplier=1.25
            is_baby
            scale 0.5
        }
        group wolf_black {
            variant 2
        }
        group wolf_chestnut {
            variant 3
        }
        group wolf_increased_max_health {
            health 40 max=40
        }
        group wolf_leashable {
            leashable {
                on_leash {
                    event minecraft:on_leash
                    target self
                }
                on_unleash {
                    event minecraft:on_unleash
                    target self
                }
            }
        }
        group wolf_pale {
            variant 0
        }
        group wolf_rusty {
            variant 4
        }
        group wolf_snowy {
            variant 5
        }
        group wolf_spotted {
            variant 6
        }
        group wolf_striped {
            variant 7
        }
        group wolf_tame {
            attack damage=4
            behavior.breed priority=2 speed_multiplier=1.0
            behavior.follow_owner priority=6 speed_multiplier=1.0 start_distance=10 stop_distance=2
            behavior.nearest_attackable_target {
                entity_type {
                    filters test=is_family subject=other value=skeleton
                    max_dist 16
                }
                must_see #true
                priority 5
            }
            behavior.owner_hurt_by_target priority=1
            behavior.owner_hurt_target priority=2
            behavior.teleport_to_owner {
                filters {
                    any_of {
                        filter {
                            filter test=owner_distance operator=> value=12
                            filter test=is_panicking
                        }
                        filter {
                            filter test=owner_distance operator=> value=24
                            filter test=has_target
                        }
                    }
                }
                priority 1
            }
            is_dyeable interact_text=action.interact.dye
            is_tamed
            sittable
        }
        group wolf_wild {
            behavior.avoid_mob_type {
                entity_type {
                    filters test=is_family subject=other value=llama
                    max_dist 24
                    sprint_speed_multiplier 1.5
                    walk_speed_multiplier 1.5
                }
                priority 3
                probability_per_strength 0.14
            }
            behavior.nearest_attackable_target {
                entity_type {
                    filters {
                        any_of {
                            filter test=is_family subject=other value=skeleton
                            filter test=is_family subject=other value=sheep
                            filter test=is_family subject=other value=rabbit
                            filter test=is_family subject=other value=fox
                        }
                    }
                    max_dist 16
                }
                entity_type {
                    filters {
                        filter test=is_family subject=other value=baby_turtle
                        filter test=in_water subject=other operator="!=" value=#true
                    }
                    max_dist 16
                }
                entity_type {
                    filters {
                        filter test=is_family subject=other value=skeleton
                        filter test=is_underwater subject=other operator="!=" value=#true
                    }
                    max_dist 16
                }
                must_see #true
                priority 4
                reselect_targets #true
            }
            on_target_acquired event=minecraft:become_angry target=self
            rideable {
                family_type baby_zombie
                family_type baby_husk
                seat_count 1
                seats {
                    seat 0.0
                    seat 0.625
                    seat -0.1
                }
            }
            tameable {
                probability 0.33
                tame_event {
                    event minecraft:on_tame
                    target self
                }
                tame_items bone
            }
        }
        group wolf_woods {
            variant 8
        }
    }
    events {
        event ageable_grow_up {
            add minecraft:wolf_adult
            remove minecraft:wolf_baby
        }
        event ageable_set_baby {
            add minecraft:wolf_baby
            remove minecraft:wolf_adult
        }
        event become_angry {
            add minecraft:wolf_angry
            remove minecraft:wolf_wild
            remove minecraft:wolf_leashable
        }
        event become_armorable {
            add minecraft:wolf_armorable
        }
        event entity_born {
            trigger minecraft:spawn_tame_baby
        }
        event entity_spawned
        event increase_max_health {
            add minecraft:wolf_increased_max_health
        }
        event on_calm {
            add minecraft:wolf_wild
            add minecraft:wolf_leashable
            remove minecraft:wolf_angry
        }
        event on_tame {
            add minecraft:wolf_tame
            add minecraft:on_tame_collar_color
            remove minecraft:wolf_wild
        }
        event randomize_sound_variant {
            randomize {
                option weight=1
                option weight=1
                option weight=1
                option weight=1
                option weight=1
                option weight=1
                option weight=1
            }
        }
        event spawn_tame_adult {
            add minecraft:wolf_adult
            add minecraft:wolf_tame
            add minecraft:wolf_leashable
            trigger minecraft:randomize_sound_variant
        }
        event spawn_tame_baby {
            add minecraft:wolf_baby
            add minecraft:wolf_tame
            add minecraft:wolf_leashable
            trigger minecraft:randomize_sound_variant
        }
        event spawn_wild_adult {
            add minecraft:wolf_adult
            add minecraft:wolf_wild
            add minecraft:wolf_leashable
            trigger minecraft:randomize_sound_variant
        }
        event spawn_wild_ashen {
            add minecraft:wolf_ashen
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_baby {
            add minecraft:wolf_baby
            add minecraft:wolf_wild
            add minecraft:wolf_leashable
            trigger minecraft:randomize_sound_variant
        }
        event spawn_wild_baby_or_adult
        event spawn_wild_black {
            add minecraft:wolf_black
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_chestnut {
            add minecraft:wolf_chestnut
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_pale {
            add minecraft:wolf_pale
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_rusty {
            add minecraft:wolf_rusty
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_snowy {
            add minecraft:wolf_snowy
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_spotted {
            add minecraft:wolf_spotted
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_striped {
            add minecraft:wolf_striped
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event spawn_wild_woods {
            add minecraft:wolf_woods
            trigger minecraft:spawn_wild_baby_or_adult
        }
        event upgrade_to_1_21_100
    }
}
