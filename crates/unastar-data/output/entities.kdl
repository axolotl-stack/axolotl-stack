            group_size {
                filters {
                    filter test=has_component operator="!=" value=minecraft:is_baby
                    filter test=is_family value=hoglin
                }
                radius 32
            }
            leashable_to
            loot table="loot_tables/entities/hoglin.json"
            movement 0.3
            on_target_acquired event=become_angry_event target=self
