    component_groups {
        group celebrate {
            behavior.celebrate {
                celebration_sound celebrate
                duration 30.0
                jump_interval {
                    range_max 3.5
                    range_min 1.0
                }
                on_celebration_end_event {
                    event minecraft:stop_celebrating
                    target self
                }
                priority 5
                sound_interval {
                    range_max 7.0
                    range_min 2.0
                }
            }
        }
        group illager_squad_captain {
            equipment {
                entry drop_chance=1.0 slot=slot.armor.chest
                table "loot_tables/entities/pillager_captain_equipment.json"
            }
            is_illager_captain
            loot table="loot_tables/entities/pillager_captain.json"
            on_hurt event=minecraft:ranged_mode target=self
            on_hurt_by_player event=minecraft:ranged_mode target=self
            variant 1
        }
        group melee_attack {
            attack damage=3
            behavior.melee_box_attack priority=4 track_target=#true
            environment_sensor {
                triggers {
                    event minecraft:ranged_mode
                    filters test=in_water subject=self operator="==" value=#false
                }
            }
        }
        group patrol_captain {
            behavior.hold_ground {
                broadcast #true
                broadcast_range 8
                min_radius 10
                priority 5
                within_radius_event {
                    event minecraft:ranged_mode
                    target self
                }
            }
            behavior.move_to_random_block block_distance=512 priority=6 speed_multiplier=0.55 within_radius=8
            equipment {
                entry drop_chance=1.0 slot=slot.armor.chest
                table "loot_tables/entities/pillager_captain_equipment.json"
            }
            is_illager_captain
            loot table="loot_tables/entities/pillager_captain.json"
            on_hurt event=minecraft:ranged_mode target=self
            on_hurt_by_player event=minecraft:ranged_mode target=self
            on_target_escape event=minecraft:calm target=self
            variant 1
        }
        group patrol_follower {
            behavior.follow_target_captain follow_distance=5 priority=5 speed_multiplier=0.8 within_radius=64
            behavior.hold_ground {
                broadcast #true
                broadcast_range 8
                min_radius 10
                priority 6
                within_radius_event {
                    event minecraft:ranged_mode
                    target self
                }
            }
            on_hurt event=minecraft:ranged_mode target=self
            on_hurt_by_player event=minecraft:ranged_mode target=self
            on_target_escape event=minecraft:calm target=self
        }
        group raid_configuration {
            ambient_sound_interval 2.0 event_name=ambient.in.raid range=4.0
            behavior.move_to_village goal_radius=2.0 priority=5 speed_multiplier=1.0
            dweller {
                can_find_poi #false
                can_migrate #true
                dweller_role hostile
                dwelling_type village
                first_founding_reward 0
                update_interval_base 60
                update_interval_variant 40
            }
            loot table="loot_tables/entities/pillager_raid.json"
        }
        group raid_persistence {
            persistent
        }
        group ranged_attack {
            behavior.ranged_attack attack_interval_max=1.0 attack_interval_min=1.0 attack_radius=8.0 priority=4
            environment_sensor {
                triggers {
                    event minecraft:melee_mode
                    filters test=is_underwater subject=self operator="==" value=#true
                }
            }
            shooter def=minecraft:arrow
        }
    }
    events {
        event calm {
            remove minecraft:melee_attack
            remove minecraft:ranged_attack
        }
        event entity_spawned {
            add minecraft:ranged_attack
        }
        event melee_mode {
            add minecraft:melee_attack
            remove minecraft:ranged_attack
        }
        event promote_to_illager_captain {
            add minecraft:ranged_attack
            add minecraft:illager_squad_captain
            remove minecraft:patrol_follower
        }
        event promote_to_patrol_captain {
            add minecraft:ranged_attack
            add minecraft:patrol_captain
            remove minecraft:patrol_follower
        }
        event raid_expired
        event ranged_mode {
            add minecraft:ranged_attack
            remove minecraft:melee_attack
        }
        event spawn_as_illager_captain {
            add minecraft:ranged_attack
            add minecraft:illager_squad_captain
        }
        event spawn_as_patrol_follower {
            add minecraft:ranged_attack
            add minecraft:patrol_follower
        }
        event spawn_for_raid {
            add minecraft:ranged_attack
            add minecraft:raid_configuration
            add minecraft:raid_persistence
        }
        event start_celebrating
        event stop_celebrating {
            remove minecraft:celebrate
        }
    }
}
