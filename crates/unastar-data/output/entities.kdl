                filters test=in_lava subject=self operator="==" value=#true
            }
        }
        is_hidden_when_invisible
        jump.static
        movement 0.1
        movement.amphibious max_turn=5.0
        nameable
        navigation.generic avoid_damage_blocks=#true can_path_over_water=#false can_sink=#false can_swim=#true can_walk=#true is_amphibious=#true
        physics
