    events {
        event become_witch {
            add become_witch
        }
        event become_zombie
        event ageable_grow_up {
            randomize {
                option weight=10
                option weight=90
            }
        }
        event become_armorer {
            add armorer
            add adult
            add make_and_receive_love
            add behavior_non_peasant
            add work_schedule
            remove baby
            remove child_schedule
            remove job_specific_goals
            remove trade_components
        }
        event become_butcher {
            add butcher
            add adult
            add make_and_receive_love
            add behavior_non_peasant
            add work_schedule
            remove baby
            remove child_schedule
            remove job_specific_goals
            remove trade_components
        }
        event become_cartographer {
            add cartographer
            add adult
            add make_and_receive_love
            add behavior_non_peasant
            add work_schedule
            remove baby
