            add minecraft:zombie_nautilus_wild_mounted
            remove minecraft:zombie_nautilus_wild_unmounted
            remove minecraft:zombie_nautilus_leashable
            remove minecraft:zombie_nautilus_tameable
            remove minecraft:zombie_nautilus_ai_controlled
        }
        event on_player_dismount {
            trigger minecraft:switch_to_ai_controlled
        }
        event on_player_mount {
            trigger minecraft:switch_to_player_controlled
        }
        event on_saddled
        event on_saddled_in_water {
            add minecraft:zombie_nautilus_tame_saddled_in_water
            remove minecraft:zombie_nautilus_tame_saddled_on_ground
        }
        event on_saddled_out_of_water {
            add minecraft:zombie_nautilus_tame_saddled_on_ground
            remove minecraft:zombie_nautilus_tame_saddled_in_water
        }
        event on_stop_tempting
        event on_tame {
            add minecraft:zombie_nautilus_tame
            add minecraft:zombie_nautilus_tame_unsaddled
            remove minecraft:zombie_nautilus_wild
            remove minecraft:zombie_nautilus_wild_unmounted
            remove minecraft:zombie_nautilus_wild_calm
            remove minecraft:zombie_nautilus_tameable
        }
        event on_unleashed
        event on_unsaddled
        event start_charge {
            add minecraft:zombie_nautilus_charging
        }
        event stop_charge {
            remove minecraft:zombie_nautilus_charging
        }
        event switch_to_ai_controlled {
            add minecraft:zombie_nautilus_ai_controlled
            remove minecraft:zombie_nautilus_player_controlled
        }
        event switch_to_player_controlled {
            add minecraft:zombie_nautilus_player_controlled
            remove minecraft:zombie_nautilus_ai_controlled
        }
    }
}
