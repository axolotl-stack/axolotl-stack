            variant 1
        }
        group interact_default {
            interact {
                interaction {
                    interact_text action.interact.milk
                    on_interact {
                        filters {
                            filter test=has_component subject=self operator="!=" value=minecraft:is_baby
                            filter test=is_family subject=other value=player
                            filter test=has_equipment subject=other domain=hand value=bucket:0
                        }
                    }
                    play_sounds milk_suspiciously
                    transform_to_item bucket:1
                    use_item #true
                }
            }
        }
        group interact_screamer {
            interact {
                interaction {
                    interact_text action.interact.milk
                    on_interact {
                        filters {
                            filter test=has_component subject=self operator="!=" value=minecraft:is_baby
                            filter test=is_family subject=other value=player
                            filter test=has_equipment subject=other domain=hand value=bucket:0
                        }
                    }
                    play_sounds milk.screamer
                    transform_to_item bucket:1
                    use_item #true
                }
            }
        }
        group ram_default {
            behavior.ram_attack {
                entry 30
                entry 300
                knockback_force 2.5
                knockback_height 0.04
                min_ram_distance 4
                entry event=start_event target=self
                pre_ram_sound pre_ram
                priority 5
                ram_distance 7
                ram_impact_sound ram_impact
                ram_speed 1.8
                run_speed 0.7
            }
        }
        group ram_screamer {
            behavior.ram_attack {
                entry 5
                entry 15
                knockback_force 2.5
                knockback_height 0.04
                min_ram_distance 4
                entry event=start_event target=self
                pre_ram_sound pre_ram.screamer
                priority 5
                ram_distance 7
                ram_impact_sound ram_impact.screamer
                ram_speed 1.8
                run_speed 0.7
            }
        }
    }
    events {
        event attack_cooldown_complete_event {
            remove attack_cooldown
        }
        event ageable_grow_up {
            add goat_adult
            remove goat_baby
        }
        event born_default {
            add goat_default
            add ram_default
            add interact_default
        }
        event born_screamer {
            add goat_screamer
            add ram_screamer
            add interact_screamer
        }
        event entity_born {
            add goat_baby
        }
        event entity_spawned {
            randomize {
                option weight=95
                option weight=5
            }
        }
        event start_event {
            add attack_cooldown
        }
    }
}
