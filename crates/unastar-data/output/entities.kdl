                within_default 6
            }
            priority 1
        }
        behavior.random_look_around priority=4
        behavior.random_stroll priority=2 speed_multiplier=1
        behavior.ranged_attack attack_interval=1 attack_radius=10 priority=1 speed_multiplier=1.25
